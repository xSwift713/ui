	function W:_MoveIndicator(instant)
		local tab = W.SelectedTab
		if not tab or not tab.Frame.Visible then
			indicator.Visible = false
			return
		end
		local btn = tab.Frame
		if btn.AbsoluteSize.Y <= 0 then
			indTry = indTry + 1
			if indTry < 30 then task.delay(0.03, function() W:_MoveIndicator(instant) end) end
			return
		end
		indTry = 0
		local s = EffectiveScale(tabHolder)
		local top = (btn.AbsolutePosition.Y - tabHolder.AbsolutePosition.Y) / s
		local bottom = top + btn.AbsoluteSize.Y / s
		if instant or not indicator.Visible then
			indicator.Visible = true
			Set(P, { Top = top, Bottom = bottom })
			SpringHooks[P](P)
			return
		end
		if top > P.Top then
			Spring(P, { Bottom = bottom }, 5, 0.75)
			Spring(P, { Top = top }, 2.5, 0.9)
		else
			Spring(P, { Top = top }, 5, 0.75)
			Spring(P, { Bottom = bottom }, 2.5, 0.9)
		end
	end
