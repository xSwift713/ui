function Elements.ProgressBar(host, cfg)
	local v = cfg.Value
	local min, max, cur
	if type(v) == "table" then min, max, cur = v.Min, v.Max, v.Default else min, max, cur = cfg.Min, cfg.Max, v end
	min, max = tonumber(min) or 0, tonumber(max) or 100
	cur = tonumber(cur) or min
	local E, B = ElementBase(host, cfg, { Type = "ProgressBar", Right = 56 })
	local pct = Text({
		Name = "Percent", Font = "SemiBold", TextSize = 13, Size = UDim2.new(1, 0, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Right, Theme = { TextColor3 = "SubText" }, Parent = B.Control,
	})
	local body = MakeBody(B.Root, true)
	Padding(0, 14, 14, 14, body)
	local track = Create("Frame", {
		Name = "Track",
		Size = UDim2.new(1, 0, 0, 8),
		Theme = { BackgroundColor3 = "Track", BackgroundTransparency = "TrackT" },
		Parent = body,
	})
	Corner(UDim.new(1, 0), track)
	local fill = AccentFill(track, { Name = "Fill", Size = UDim2.new(0, 0, 1, 0) })
	Corner(UDim.new(1, 0), fill)

	local function render(instant)
		local p = Clamp01((cur - min) / math.max(max - min, 1e-9))
		E.Value = cur
		pct.Text = tostring(math.floor(p * 100 + 0.5)) .. "%"
		if instant then Set(fill, { Size = UDim2.new(p, 0, 1, 0) })
		else Spring(fill, { Size = UDim2.new(p, 0, 1, 0) }, 2.5, 0.85) end
	end
	function E:Set(x)
		cur = math.clamp(tonumber(x) or cur, min, max)
		render(false)
		E._Fire(cur)
	end
	E.SetValue = E.Set
	function E:Get() return cur end
	E.GetValue = E.Get
	function E:GetPercentage() return (cur - min) / math.max(max - min, 1e-9) * 100 end
	function E:SetRange(a, b) min, max = tonumber(a) or min, tonumber(b) or max render(false) end
	function E:SetMin(a) E:SetRange(a, max) end
	function E:SetMax(b) E:SetRange(min, b) end
	render(true)
	return Finalize(E, cfg, host)
end

