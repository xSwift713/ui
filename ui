-- 实心主题色上的文字: 白字对比度够用 (>= 3.4) 时优先白字, 否则按 WCAG 对比度取更高者
local ON_DARK = RGB(20, 22, 28)
local function Luminance(c)
	local function lin(v)
		if v <= 0.03928 then return v / 12.92 end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * lin(c.R) + 0.7152 * lin(c.G) + 0.0722 * lin(c.B)
end
local function AutoOnAccent(c)
	local l = Luminance(c)
	local vsWhite = 1.05 / (l + 0.05)
	local vsDark = (l + 0.05) / (Luminance(ON_DARK) + 0.05)
	if vsWhite >= 3.4 or vsWhite >= vsDark then return WHITE end
	return ON_DARK
end

local function MakeTheme(name, base, over)
