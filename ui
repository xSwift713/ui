function WindUI:Notify(cfg)
	cfg = cfg or {}
	local holder = GetNotifyHolder()
	holder.Position = UDim2.new(1, -16, 1, self.NotificationLower and -8 or -16)
	local kind = NotifyTypes[cfg.Type or ""] or NotifyTypes.Info
	local duration = cfg.Duration
	if duration == nil then duration = 5 end
	local N = { Closed = false }

	local wrap = Create("Frame", {
		Name = "Notification",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = math.floor(tick() * 10) % 1e8,
		Parent = holder,
	})
	-- 卡片固定高度并跟随内容框 (光泽层 / 倒计时条贴底, 不能放进自动高度容器)
	local card = Create("Frame", {
		Name = "Card",
		Size = UDim2.new(1, 0, 0, 60),
		Position = UDim2.new(0, 360, 0, 0),
		Theme = {
			BackgroundColor3 = "Glass",
			BackgroundTransparency = function(th) return math.min(GlassT(th), 0.3) end,
		},
		Parent = wrap,
	})
	Corner(14, card)
	Rim(card)
	Sheen(card, 14, 1)
	local inner = Create("Frame", {
		Name = "Inner",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = card,
	})
	Padding(12, 16, 14, 14, inner)
	FollowHeight(card, inner)

	local accentKey = kind.Color
	local icon = cfg.Icon or kind.Icon
	local iconBox = Create("Frame", {
		Name = "IconBox",
		Size = UDim2.new(0, 30, 0, 30),
		ZIndex = 2,
		Theme = { BackgroundColor3 = accentKey },
		BackgroundTransparency = 0.82,
		Parent = inner,
	})
	Corner(9, iconBox)
	IconImage(icon, 17, {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), ZIndex = 3,
		Theme = { ImageColor3 = accentKey }, Parent = iconBox,
	})

	local body = Create("Frame", {
		Name = "Body",
		Position = UDim2.new(0, 42, 0, 0),
		Size = UDim2.new(1, cfg.CanClose == false and -42 or -66, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = inner,
	})
	List(body, 3)
	Text({ Name = "Title", Text = cfg.Title or "Notification", Font = "SemiBold", TextSize = 15,
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, ZIndex = 2, LayoutOrder = 1, Parent = body })
	if cfg.Content and cfg.Content ~= "" then
		Text({ Name = "Content", Text = tostring(cfg.Content), TextSize = 13, Font = "Regular",
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, ZIndex = 2, LayoutOrder = 2,
			Theme = { TextColor3 = "SubText" }, Parent = body })
	end
	if cfg.SubContent and cfg.SubContent ~= "" then
		Text({ Name = "SubContent", Text = tostring(cfg.SubContent), TextSize = 12, Font = "Regular",
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, ZIndex = 2, LayoutOrder = 3,
			Theme = { TextColor3 = "Placeholder" }, Parent = body })
	end

	local bar
	if duration and duration > 0 then
		local track = Create("Frame", {
			Name = "Timer",
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 14, 1, -7),
			Size = UDim2.new(1, -28, 0, 2),
			ZIndex = 2,
			Theme = { BackgroundColor3 = "Track", BackgroundTransparency = "TrackT" },
			Parent = card,
		})
		Corner(1, track)
		bar = Create("Frame", { Name = "Fill", Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = WHITE, ZIndex = 3, Parent = track })
		Corner(1, bar)
		local g = Create("UIGradient", { Parent = bar })
		Bind(g, { Color = AccentSequence })
	end

	function N:Close()
		if N.Closed then return end
		N.Closed = true
		Spring(card, { Position = UDim2.new(0, 360, 0, 0) }, 3.2, 1)
		task.delay(0.22, function()
			local h = wrap.AbsoluteSize.Y
			wrap.AutomaticSize = Enum.AutomaticSize.None
			wrap.Size = UDim2.new(1, 0, 0, h)
			wrap.ClipsDescendants = true
			Spring(wrap, { Size = UDim2.new(1, 0, 0, 0) }, 4, 1)
			task.delay(0.4, function() wrap:Destroy() end)
		end)
	end

	if cfg.CanClose ~= false then
		local close = Create("ImageButton", {
			Name = "Close",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 4, 0, -2),
			Size = UDim2.new(0, 22, 0, 22),
			BackgroundTransparency = 1,
			Image = GetIcon("x") or "",
			ZIndex = 4,
			Theme = { ImageColor3 = "SubText" },
			Parent = inner,
		})
		close.MouseButton1Click:Connect(function() N:Close() end)
	end

	Spring(card, { Position = UDim2.new(0, 0, 0, 0) }, 2.6, 0.72)
	if bar then
		Tween(bar, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 1, 0) })
		task.delay(duration, function() N:Close() end)
	end
	return N
end

--------------------------------------------------------------------------
-- 颜色工具
--------------------------------------------------------------------------
local NamedColors = {
	Red = RGB(239, 68, 68), Orange = RGB(249, 115, 22), Yellow = RGB(234, 179, 8),
	Green = RGB(34, 197, 94), Blue = RGB(59, 130, 246), Purple = RGB(168, 85, 247),
	Pink = RGB(236, 72, 153), Grey = RGB(120, 120, 130), Gray = RGB(120, 120, 130), White = WHITE,
}

local function ResolveColor(c)
	if c == nil then return nil end
	if NamedColors[c] then return NamedColors[c] end
	return ToColor(c, nil)
end

local function ColorToHex(c)
	return string.format("%02X%02X%02X",
		math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

local function ToHSV(c)
	local r, g, b = c.R, c.G, c.B
	local mx, mn = math.max(r, g, b), math.min(r, g, b)
	local d = mx - mn
	local h = 0
	if d > 0 then
		if mx == r then h = ((g - b) / d) % 6
		elseif mx == g then h = (b - r) / d + 2
		else h = (r - g) / d + 4 end
		h = h / 6
	end
	local s = mx > 0 and d / mx or 0
	return h, s, mx
end

local function IsLucide(icon)
	if type(icon) ~= "string" then return false end
	local name = icon:gsub("^lucide[%-:]", ""):lower()
	return IconMap[name] ~= nil
end

--------------------------------------------------------------------------
-- 元素宿主 (Tab / SubTab / Section / Group 共用的元素方法)
--------------------------------------------------------------------------
local HostMethods = {}
local HostMT = { __index = HostMethods }
local Elements = {}

local function NewHost(window, tab, container, obj)
	local h = setmetatable(obj or {}, HostMT)
	h.Window = window
	h.Tab = tab or h
	h.Container = container
	h._order = 0
	return h
end

function HostMethods:_Order()
	self._order = self._order + 1
	return self._order
end

function HostMethods:_Added() end

local function NormalizeArgs(a, b)
	local cfg
	if type(a) == "table" then
		cfg = a
	elseif type(b) == "table" then
		cfg = b
		if cfg.Flag == nil and a ~= nil then cfg.Flag = a end
	elseif a ~= nil then
		cfg = { Title = tostring(a) }
	else
		cfg = {}
	end
	if cfg.Title == nil then cfg.Title = cfg.Name end
	if cfg.Desc == nil then cfg.Desc = cfg.Description or cfg.Content end
	if cfg.Value == nil and cfg.Default ~= nil then cfg.Value = cfg.Default end
	return cfg
end

--------------------------------------------------------------------------
-- 元素基座: 玻璃卡片 + 标题/描述 + 右侧控件区 + 锁定遮罩
--------------------------------------------------------------------------
local function ElementBase(host, cfg, opt)
	opt = opt or {}
	local window, tab = host.Window, host.Tab
	local state = { Hover = false, Press = false }
	local tint = ResolveColor(cfg.Color)
	local E = {
		__type = opt.Type, Type = opt.Type,
		Title = cfg.Title, Desc = cfg.Desc,
		Locked = false, Visible = true,
		Window = window, Tab = tab, Parent = host,
		Callback = cfg.Callback,
		UIElements = {},
	}

	local root = Create("Frame", {
		Name = opt.Type or "Element",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = host:_Order(),
		Theme = {
			-- Active: 开关打开等 "激活" 状态时卡片染上主题色微光
			BackgroundColor3 = function(th)
				if state.Active then return th.Accent end
				return tint or th.Element
			end,
			BackgroundTransparency = function(th)
				local base = state.Active and th.ActiveT or (tint and 0.78 or th.ElementT)
				if state.Press then return base - th.HoverDelta * 1.8 end
				if state.Hover then return base - th.HoverDelta end
				return base
			end,
		},
		Parent = host.Container,
	})
	Corner(12, root)
	local stroke = Rim(root, function(th)
		local t = th.ElementStrokeT
		if state.Active then t = t - 0.2 end
		if state.Hover then t = t - 0.24 end
		return math.max(t, 0)
	end)
	List(root, 0)

	-- 标题区: 外层 header 为固定高度 (跟随内部自动高度的 inner),
	-- 覆盖层 / 图标块 / 右侧控件都挂在 header 上, 不参与自动高度计算
	local header = Create("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = root,
	})
	local inner = Create("Frame", {
		Name = "Inner",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = header,
	})
	Padding(13, 13, 14, 14, inner)
	Create("Frame", { Name = "MinHeight", Size = UDim2.new(0, 0, 0, opt.MinHeight or 18), BackgroundTransparency = 1, Parent = inner })
	FollowHeight(header, inner)

	-- 特效层 (水波纹 / 悬停柔光), 铺满标题区并裁剪, 位于文字下方
	local fx = Create("Frame", {
		Name = "FX",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = 1,
		Parent = header,
	})

	local iconOff = 0
	local iconSrc = cfg.Icon or (opt.Type == "Paragraph" and cfg.Image) or nil
	local iconImg
	if iconSrc and GetIcon(iconSrc) then
		if IsLucide(iconSrc) then
			-- iOS 设置页风格的彩色图标块
			local chipColor = ResolveColor(cfg.IconColor)
			local chip = Create("Frame", {
				Name = "IconChip",
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 14, 0.5, 0),
				Size = UDim2.new(0, 30, 0, 30),
				BackgroundColor3 = chipColor or WHITE,
				ZIndex = 2,
				Parent = header,
			})
			Corner(9, chip)
			if not chipColor then
				local g = Create("UIGradient", { Rotation = 45, Parent = chip })
				Bind(g, { Color = AccentSequence })
			end
			Create("Frame", {
				Name = "Gloss",
				Size = UDim2.new(1, 0, 0.5, 0),
				BackgroundColor3 = WHITE,
				BackgroundTransparency = 0.82,
				BorderSizePixel = 0,
				ZIndex = 2,
				Parent = chip,
			}, {
				Create("UIGradient", { Rotation = 90, Transparency = NS({ { 0, 0 }, { 1, 1 } }) }),
			})
			Corner(9, chip:FindFirstChild("Gloss"))
			iconImg = IconImage(iconSrc, 17, {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, 0, 0.5, 0),
				ZIndex = 3,
				Theme = { ImageColor3 = chipColor and function() return WHITE end or "OnAccent" },
				Parent = chip,
			})
			iconOff = 42
		else
			local size = cfg.ImageSize or cfg.IconSize or 20
			if type(size) ~= "number" then size = 20 end
			size = math.min(size, 48)
			iconImg = Create("ImageLabel", {
				Name = "Icon",
				Image = GetIcon(iconSrc) or "",
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 14, 0.5, 0),
				Size = UDim2.new(0, size, 0, size),
				BackgroundTransparency = 1,
				ZIndex = 2,
				Parent = header,
			})
			Corner(8, iconImg)
			iconOff = size + 12
		end
	end

	local right = opt.Right or 0
	local labels = Create("Frame", {
		Name = "Labels",
		Position = UDim2.new(0, iconOff, 0, 0),
		Size = UDim2.new(1, -(iconOff + right + (right > 0 and 14 or 0)), 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = inner,
	})
	List(labels, 3)
	local title = Text({
		Name = "Title",
		Text = cfg.Title or "",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextWrapped = true,
		Visible = cfg.Title ~= nil and cfg.Title ~= "",
		LayoutOrder = 1,
		Parent = labels,
	})
	local desc = Text({
		Name = "Desc",
		Text = cfg.Desc and tostring(cfg.Desc) or "",
		TextSize = 13,
		Font = "Regular",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextWrapped = true,
		Visible = cfg.Desc ~= nil and cfg.Desc ~= "",
		LayoutOrder = 2,
		Theme = { TextColor3 = "SubText" },
		Parent = labels,
	})

	local control
	if right > 0 then
		control = Create("Frame", {
			Name = "Control",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -14, 0.5, 0),
			Size = UDim2.new(0, right, 0, opt.ControlHeight or 28),
			BackgroundTransparency = 1,
			ZIndex = 4,
			Parent = header,
		})
	end

	local click
	if opt.Clickable then
		click = Create("TextButton", {
			Name = "Click",
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 1, 0),
			ZIndex = 3,
			Parent = header,
		})
		click.MouseButton1Down:Connect(function()
			if E.Locked then return end
			state.Press = true
			Restyle(root, 7)
			Ripple(fx)
		end)
		local function up()
			if state.Press then
				state.Press = false
				Restyle(root, 4)
			end
		end
		click.MouseButton1Up:Connect(up)
		click.MouseLeave:Connect(up)
	end

	root.MouseEnter:Connect(function()
		state.Hover = true
		Restyle(root, 6)
		Restyle(stroke, 6)
	end)
	root.MouseLeave:Connect(function()
		state.Hover = false
		state.Press = false
		Restyle(root, 4)
		Restyle(stroke, 4)
	end)

	-- 锁定遮罩
	local lock = Create("TextButton", {
		Name = "Lock",
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		ZIndex = 20,
		Visible = false,
		Theme = { BackgroundColor3 = "Glass" },
		Parent = header,
	})
	Corner(12, lock)
	local lockRow = Create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.new(0, 0, 0, 20),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		ZIndex = 21,
		Parent = lock,
	})
	List(lockRow, 6, true, { VerticalAlignment = Enum.VerticalAlignment.Center })
	local lockIcon = IconImage("lock", 15, { ZIndex = 21, ImageTransparency = 1, LayoutOrder = 1, Theme = { ImageColor3 = "Text" }, Parent = lockRow })
	local lockText = Text({
		Name = "Reason", Text = "", TextSize = 12, ZIndex = 21, TextTransparency = 1, LayoutOrder = 2,
		AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 1, 0), Parent = lockRow,
	})

	E.ElementFrame = root
	E.UIElements.Main = root
	E.UIElements.Header = header
	E.UIElements.Title = title
	E.UIElements.Desc = desc

	function E:SetTitle(t)
		E.Title = t
		title.Text = t and tostring(t) or ""
		title.Visible = t ~= nil and t ~= ""
	end

	function E:SetDesc(d)
		E.Desc = d
		desc.Text = d and tostring(d) or ""
		desc.Visible = d ~= nil and d ~= ""
	end
	E.SetDescription = E.SetDesc
	E.SetContent = E.SetDesc

	function E:Lock(reason)
		E.Locked = true
		if E._OnLock then E._OnLock() end
		lockText.Text = reason or cfg.LockedTitle or ""
		lock.Visible = true
		Spring(lock, { BackgroundTransparency = 0.42 }, 4, 1)
		Spring(lockIcon, { ImageTransparency = 0.1 }, 4, 1)
		Spring(lockText, { TextTransparency = 0.1 }, 4, 1)
	end

	function E:Unlock()
		E.Locked = false
		Spring(lock, { BackgroundTransparency = 1 }, 4, 1)
		Spring(lockIcon, { ImageTransparency = 1 }, 4, 1)
		Spring(lockText, { TextTransparency = 1 }, 4, 1)
		task.delay(0.35, function()
			if not E.Locked then lock.Visible = false end
		end)
	end

	function E:SetVisible(v)
		E.Visible = v and true or false
		root.Visible = E.Visible
	end

	function E:Highlight()
		Set(stroke, { Color = WindUI.Theme.Accent, Transparency = 0 })
		task.delay(0.15, function() Restyle(stroke, 1.2) end)
	end

	function E:Destroy()
		root:Destroy()
		local i = Find(tab.Elements, E)
		if i then table.remove(tab.Elements, i) end
		i = Find(window.AllElements, E)
		if i then table.remove(window.AllElements, i) end
		if E.Flag then
			window.Flags[E.Flag] = nil
			if WindUI.Options[E.Flag] == E then WindUI.Options[E.Flag] = nil end
		end
	end

	function E:GetValue() return E.Value end
	E.Get = E.GetValue

	function E:OnChanged(fn)
		E.Changed = fn
		SafeCall(fn, E.Value)
	end

	function E._Fire(...)
		SafeCall(E.Callback, ...)
		SafeCall(E.Changed, ...)
	end

	function E._SetActive(on, instant)
		state.Active = on and true or false
		Restyle(root, instant and 60 or 3.5)
		Restyle(stroke, instant and 60 or 3.5)
	end

	table.insert(tab.Elements, E)
	table.insert(window.AllElements, E)

	return E, {
		Root = root, Header = header, Labels = labels, Title = title, Desc = desc,
		Control = control, Click = click, Stroke = stroke, State = state, Icon = iconImg,
	}
end

local function Finalize(E, cfg, host)
	local w = host.Window
	if cfg.Flag then
		E.Flag = cfg.Flag
		w.Flags[cfg.Flag] = E
		WindUI.Options[cfg.Flag] = E
	end
	if cfg.Locked then E:Lock(cfg.LockedTitle) end
	if cfg.Tooltip then Tooltip.Attach(E.ElementFrame, cfg.Tooltip) end
	if cfg.Visible == false then E:SetVisible(false) end
	host:_Added(E)
	return E
end

-- 展开区 (下拉菜单 / 调色板 / 文本域 ...)
local function MakeBody(root, autoSize)
	local body = Create("Frame", {
		Name = "Body",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = autoSize and Enum.AutomaticSize.Y or Enum.AutomaticSize.None,
		ClipsDescendants = not autoSize,
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Parent = root,
	})
	return body
end

local function Field(parent, props)
	local p = {
		Name = "Field",
		Theme = { BackgroundColor3 = "Field", BackgroundTransparency = "FieldT" },
		Parent = parent,
	}
	for k, v in pairs(props or {}) do p[k] = v end
	local f = Create("Frame", p)
	Corner(9, f)
	return f
end

local function AccentFill(parent, props)
	local p = { BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = parent }
	for k, v in pairs(props or {}) do p[k] = v end
	local f = Create("Frame", p)
	local g = Create("UIGradient", { Parent = f })
	Bind(g, { Color = AccentSequence })
	return f, g
end

--------------------------------------------------------------------------
-- Toggle / Checkbox
--------------------------------------------------------------------------
function Elements.Toggle(host, cfg)
	local checkbox = cfg.Type == "Checkbox"
	local E, B = ElementBase(host, cfg, { Type = "Toggle", Right = checkbox and 26 or 48, Clickable = true })
	E.Value = cfg.Value and true or false

	local render
	if checkbox then
		local box = Create("Frame", {
			Name = "Checkbox",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.new(0, 24, 0, 24),
			Theme = {
				BackgroundColor3 = function(th) return E.Value and th.Accent or th.Track end,
				BackgroundTransparency = function(th) return E.Value and 0 or th.TrackT end,
			},
			Parent = B.Control,
		})
		Corner(7, box)
		Rim(box, "ElementStrokeT")
		local check = IconImage("check", 16, {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), ZIndex = 4,
			Theme = { ImageColor3 = "OnAccent" }, Parent = box,
		})
		local scale = Create("UIScale", { Scale = E.Value and 1 or 0, Parent = check })
		render = function(animate)
			if animate then
				Restyle(box, 5)
				Spring(scale, { Scale = E.Value and 1 or 0 }, 4.5, 0.5)
			else
				Restyle(box, 50)
				Set(scale, { Scale = E.Value and 1 or 0 })
			end
		end
	else
		local track = Create("Frame", {
			Name = "Track",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.new(0, 46, 0, 26),
			Theme = { BackgroundColor3 = "Track", BackgroundTransparency = "TrackT" },
			Parent = B.Control,
		})
		Corner(UDim.new(1, 0), track)
		Rim(track, "ElementStrokeT")
		local fill = AccentFill(track, { Name = "Fill", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = E.Value and 0 or 1, ZIndex = 2 })
		Corner(UDim.new(1, 0), fill)
		local knob = Create("Frame", {
			Name = "Knob",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0, E.Value and 33 or 13, 0.5, 0),
			Size = UDim2.new(0, 20, 0, 20),
			BackgroundColor3 = WHITE,
			ZIndex = 4,
			Parent = track,
		})
		Corner(UDim.new(1, 0), knob)
		Create("UIStroke", { Color = BLACK, Transparency = 0.86, Thickness = 1, Parent = knob })
		Create("UIGradient", {
			Rotation = 90,
			Color = CS({ { 0, WHITE }, { 1, RGB(222, 228, 240) } }),
			Parent = knob,
		})
		B.Click.MouseButton1Down:Connect(function()
			if E.Locked then return end
			Spring(knob, { Size = UDim2.new(0, 25, 0, 20) }, 6, 1)
		end)
		render = function(animate)
			local x = E.Value and 33 or 13
			if animate then
				Spring(fill, { BackgroundTransparency = E.Value and 0 or 1 }, 4, 1)
				Spring(knob, { Size = UDim2.new(0, 26, 0, 20) }, 8, 1)
				Spring(knob, { Position = UDim2.new(0, x, 0.5, 0) }, 3.2, 0.6)
				task.delay(0.12, function()
					Spring(knob, { Size = UDim2.new(0, 20, 0, 20) }, 3.6, 0.45)
				end)
			else
				Set(fill, { BackgroundTransparency = E.Value and 0 or 1 })
				Set(knob, { Position = UDim2.new(0, x, 0.5, 0), Size = UDim2.new(0, 20, 0, 20) })
			end
		end
	end

	function E:Set(v, isCallback)
		E.Value = v and true or false
		render(true)
		E._SetActive(E.Value)
		if isCallback ~= false then E._Fire(E.Value) end
	end
	E.SetValue = E.Set

	B.Click.MouseButton1Click:Connect(function()
		if E.Locked then return end
		E:Set(not E.Value)
	end)

	render(false)
	E._SetActive(E.Value, true)
	return Finalize(E, cfg, host)
end

--------------------------------------------------------------------------
-- Slider
--------------------------------------------------------------------------
function Elements.Slider(host, cfg)
	local v = cfg.Value
	local min, max, def
	if type(v) == "table" then
		min, max, def = v.Min, v.Max, v.Default
	else
		min, max, def = cfg.Min, cfg.Max, v
	end
	min = tonumber(min) or 0
	max = tonumber(max) or 100
	if max <= min then max = min + 1 end
	def = tonumber(def) or min

	local step = tonumber(cfg.Step)
	local decimals = 0
	if cfg.Rounding and not step then
		decimals = cfg.Rounding
		step = 10 ^ (-decimals)
	end
	step = step or 1
	if decimals == 0 then
		local s = tostring(step)
		local dot = s:find("%.")
		if dot then decimals = #s - dot end
	end

	local showBox = cfg.IsTextbox ~= false
	local width = cfg.Width or 200
	local E, B = ElementBase(host, cfg, { Type = "Slider", Right = width, ControlHeight = 28 })
	E.Value = { Min = min, Max = max, Default = def }
	E.Step = step

	local function fmt(x)
		return string.format("%." .. decimals .. "f", x)
	end
	local function quantize(x)
		x = math.clamp(x, min, max)
		x = min + math.floor((x - min) / step + 0.5) * step
		return tonumber(fmt(math.clamp(x, min, max)))
	end
	E.Value.Default = quantize(def)

	local boxW = showBox and 48 or 0
	local area = Create("TextButton", {
		Name = "Area",
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -(boxW + (showBox and 12 or 0)), 1, 0),
		Position = UDim2.new(0, 6, 0, 0),
		Parent = B.Control,
	})
	local track = Create("Frame", {
		Name = "Track",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, 0, 0, 6),
		Theme = { BackgroundColor3 = "Track", BackgroundTransparency = "TrackT" },
		Parent = area,
	})
	Corner(UDim.new(1, 0), track)
	local fill = AccentFill(track, { Name = "Fill", Size = UDim2.new(0, 0, 1, 0), ZIndex = 2 })
	Corner(UDim.new(1, 0), fill)
	local knob = Create("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(0, 16, 0, 16),
		BackgroundColor3 = WHITE,
		ZIndex = 4,
		Parent = area,
	})
	Corner(UDim.new(1, 0), knob)
	local knobRing = Create("UIStroke", { Thickness = 2, Transparency = 0.4, Theme = { Color = "Accent" }, Parent = knob })

	local tip, tipLabel
	if cfg.IsTooltip then
		tip = Create("Frame", {
			Name = "Tooltip",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 0, -6),
			Size = UDim2.new(0, 0, 0, 22),
			AutomaticSize = Enum.AutomaticSize.X,
			Visible = false,
			ZIndex = 8,
			Theme = { BackgroundColor3 = "Accent" },
			Parent = knob,
		})
		Corner(7, tip)
		Padding(0, 0, 8, 8, tip)
		tipLabel = Text({ Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, TextSize = 12, Font = "SemiBold", ZIndex = 9, Theme = { TextColor3 = "OnAccent" }, Parent = tip })
	end

	local box, boxFocused = nil, false
	if showBox then
		local holder = Field(B.Control, {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.new(0, boxW, 0, 26),
		})
		box = Create("TextBox", {
			Name = "Value",
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			Text = fmt(E.Value.Default),
			ClearTextOnFocus = false,
			Font = "SemiBold",
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Center,
			Theme = { TextColor3 = "Text" },
			Parent = holder,
		})
		box.Focused:Connect(function() boxFocused = true end)
	end

	local function render(instant)
		local p = (E.Value.Default - min) / (max - min)
		if instant then
			Set(fill, { Size = UDim2.new(p, 0, 1, 0) })
			Set(knob, { Position = UDim2.new(p, 0, 0.5, 0) })
		else
			Spring(fill, { Size = UDim2.new(p, 0, 1, 0) }, 6, 0.9)
			Spring(knob, { Position = UDim2.new(p, 0, 0.5, 0) }, 6, 0.9)
		end
		if box and not boxFocused then box.Text = fmt(E.Value.Default) end
		if tipLabel then tipLabel.Text = fmt(E.Value.Default) end
	end

	function E:Set(x)
		x = tonumber(x)
		if not x then return end
		E.Value.Default = quantize(x)
		render(false)
		E._Fire(E.Value.Default)
	end
	E.SetValue = E.Set

	function E:GetValue() return E.Value.Default end
	E.Get = E.GetValue

	function E:SetMin(m)
		min = tonumber(m) or min
		E.Value.Min = min
		E:Set(E.Value.Default)
	end

	function E:SetMax(m)
		max = tonumber(m) or max
		E.Value.Max = max
		E:Set(E.Value.Default)
	end

	function E:OnChanged(fn)
		E.Changed = fn
		SafeCall(fn, E.Value.Default)
	end

	if box then
		box.FocusLost:Connect(function()
			boxFocused = false
			local n = tonumber(box.Text)
			if n and not E.Locked then
				E:Set(n)
			else
				box.Text = fmt(E.Value.Default)
			end
		end)
	end

	local function fromX(px)
		local p = (px - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1)
		local x = quantize(min + Clamp01(p) * (max - min))
		if x ~= E.Value.Default then
			E.Value.Default = x
			render(false)
			E._Fire(x)
		end
	end

	OnDrag(area, function(input)
		if E.Locked then return false end
		Spring(knob, { Size = UDim2.new(0, 22, 0, 22) }, 5, 0.55)
		Spring(track, { Size = UDim2.new(1, 0, 0, 8) }, 5, 1)
		Spring(knobRing, { Transparency = 0 }, 5, 1)
		if tip then tip.Visible = true end
		fromX(input.Position.X)
	end, function(input)
		fromX(input.Position.X)
	end, function()
		Spring(knob, { Size = UDim2.new(0, 16, 0, 16) }, 4, 0.5)
		Spring(track, { Size = UDim2.new(1, 0, 0, 6) }, 5, 1)
		Spring(knobRing, { Transparency = 0.4 }, 5, 1)
		if tip then tip.Visible = false end
	end)

	render(true)
	return Finalize(E, cfg, host)
end

--------------------------------------------------------------------------
-- Dropdown (单选 / 多选 / 搜索)
--------------------------------------------------------------------------
local function ItemKey(item)
	if type(item) == "table" then return tostring(item.Title or item.Name or item.Value or "") end
	return tostring(item)
end

function Elements.Dropdown(host, cfg)
	local width = math.clamp(cfg.MenuWidth or 170, 120, 240)
	local E, B = ElementBase(host, cfg, { Type = "Dropdown", Right = width, Clickable = true })
	E.Values = cfg.Values or {}
	E.Multi = cfg.Multi and true or false
	E.AllowNone = cfg.AllowNone
	E.Opened = false

	local function normalize(val)
		if E.Multi then
			local out = {}
			if type(val) == "table" and val.Title == nil then
				if #val > 0 then
					for _, x in ipairs(val) do table.insert(out, x) end
				else
					for k, on in pairs(val) do
						if on == true then table.insert(out, k) end
					end
				end
			elseif val ~= nil then
				table.insert(out, val)
			end
			return out
		end
		if type(val) == "number" and E.Values[val] ~= nil then return E.Values[val] end
		return val
	end
	E.Value = normalize(cfg.Value)

	local function isSelected(item)
		local k = ItemKey(item)
		if E.Multi then
			for _, x in ipairs(E.Value) do
				if ItemKey(x) == k then return true end
			end
			return false
		end
		return E.Value ~= nil and ItemKey(E.Value) == k
	end

	local function displayText()
		if E.Multi then
			if #E.Value == 0 then return "--" end
			local t = {}
			for _, x in ipairs(E.Value) do table.insert(t, ItemKey(x)) end
			return table.concat(t, ", ")
		end
		if E.Value == nil then return "--" end
		return ItemKey(E.Value)
	end

	local field = Field(B.Control, { Size = UDim2.new(1, 0, 1, 0) })
	Rim(field, "ElementStrokeT")
	local display = Text({
		Name = "Display",
		Text = displayText(),
		TextSize = 13,
		Position = UDim2.new(0, 10, 0, 0),
		Size = UDim2.new(1, -36, 1, 0),
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = field,
	})
	local chevron = IconImage("chevron-down", 16, {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
		Theme = { ImageColor3 = "SubText" }, Parent = field,
	})

	local body = MakeBody(B.Root, false)
	local menu = Create("Frame", {
		Name = "Menu",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Parent = body,
	})
	Padding(0, 10, 10, 10, menu)
	Create("Frame", {
		Name = "Line",
		Size = UDim2.new(1, 0, 0, 1),
		Theme = { BackgroundColor3 = "Track", BackgroundTransparency = "TrackT" },
		BorderSizePixel = 0,
		Parent = menu,
	})

	local searchH = 0
	local searchBox
	if cfg.SearchBarEnabled or #E.Values > 8 then
		searchH = 38
		local sf = Field(menu, { Position = UDim2.new(0, 0, 0, 7), Size = UDim2.new(1, 0, 0, 28) })
		IconImage("search", 14, {
			AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 9, 0.5, 0),
			Theme = { ImageColor3 = "Placeholder" }, Parent = sf,
		})
		searchBox = Create("TextBox", {
			Name = "Search",
			Text = "",
			PlaceholderText = "Search...",
			ClearTextOnFocus = false,
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 30, 0, 0),
			Size = UDim2.new(1, -36, 1, 0),
			TextSize = 13,
			Font = "Regular",
			TextXAlignment = Enum.TextXAlignment.Left,
			Theme = { TextColor3 = "Text", PlaceholderColor3 = "Placeholder" },
			Parent = sf,
		})
	end

	local list = Create("ScrollingFrame", {
		Name = "List",
		Position = UDim2.new(0, 0, 0, searchH + 6),
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Theme = { ScrollBarImageColor3 = "SubText" },
		Parent = menu,
	})
	List(list, 2)

	local items = {}
	local function listHeight()
		local n = 0
		for _, it in ipairs(items) do
			if it.Button.Visible then n = n + 1 end
		end
		return math.max(math.min(n * 34, 238), 30)
	end

	local function restyleItems()
		for _, it in ipairs(items) do
			Restyle(it.Button, 6)
			Spring(it.Check, { ImageTransparency = isSelected(it.Item) and 0 or 1 }, 6, 1)
		end
		display.Text = displayText()
	end

	local function resize()
		local lh = listHeight()
		list.Size = UDim2.new(1, 0, 0, lh)
		if E.Opened then
			Spring(body, { Size = UDim2.new(1, 0, 0, lh + searchH + 16) }, 4.2, 0.8)
		end
	end

	function E:Open()
		if E.Locked then return end
		E.Opened = true
		resize()
		Spring(chevron, { Rotation = 180 }, 4.5, 0.65)
	end

	function E:Close()
		E.Opened = false
		Spring(body, { Size = UDim2.new(1, 0, 0, 0) }, 4.5, 1)
		Spring(chevron, { Rotation = 0 }, 4.5, 0.65)
	end
	E._OnLock = function() E:Close() end

	local function choose(item)
		if E.Locked then return end
		if E.Multi then
			local idx
			for i, x in ipairs(E.Value) do
				if ItemKey(x) == ItemKey(item) then idx = i end
			end
			if idx then
				if #E.Value > 1 or E.AllowNone then table.remove(E.Value, idx) end
			else
				table.insert(E.Value, item)
			end
		else
			if E.Value ~= nil and ItemKey(E.Value) == ItemKey(item) then
				if E.AllowNone then E.Value = nil end
			else
				E.Value = item
			end
			E:Close()
		end
		restyleItems()
		if type(item) == "table" and item.Callback then SafeCall(item.Callback, item) end
		E._Fire(E.Value)
	end

	local function build()
		for _, it in ipairs(items) do it.Button:Destroy() end
		items = {}
		for i, item in ipairs(E.Values) do
			local st = { Hover = false }
			local btn = Create("TextButton", {
				Name = "Option",
				Text = "",
				AutoButtonColor = false,
				Size = UDim2.new(1, 0, 0, 32),
				LayoutOrder = i,
				Theme = {
					BackgroundColor3 = function(th) return isSelected(item) and th.Accent or th.Element end,
					BackgroundTransparency = function(th)
						if isSelected(item) then return th.SelectT end
						return st.Hover and (th.Dark and 0.92 or 0.5) or 1
					end,
				},
				Parent = list,
			})
			Corner(8, btn)
			local off = 10
			if type(item) == "table" and item.Icon and GetIcon(item.Icon) then
				IconImage(item.Icon, 16, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), Parent = btn })
				off = 34
			end
			Text({
				Name = "Label",
				Text = ItemKey(item),
				TextSize = 13,
				Position = UDim2.new(0, off, 0, 0),
				Size = UDim2.new(1, -(off + 30), 1, 0),
				TextTruncate = Enum.TextTruncate.AtEnd,
				Parent = btn,
			})
			local check = IconImage("check", 15, {
				AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
				ImageTransparency = isSelected(item) and 0 or 1,
				Theme = { ImageColor3 = "Accent" }, Parent = btn,
			})
			btn.MouseEnter:Connect(function() st.Hover = true Restyle(btn, 7) end)
			btn.MouseLeave:Connect(function() st.Hover = false Restyle(btn, 5) end)
			btn.MouseButton1Click:Connect(function() choose(item) end)
			if type(item) == "table" and item.Locked then
				btn.Active = false
				btn.AutoButtonColor = false
			end
			table.insert(items, { Button = btn, Check = check, Item = item })
		end
		if searchBox then searchBox.Text = "" end
		restyleItems()
		resize()
	end

	if searchBox then
		searchBox:GetPropertyChangedSignal("Text"):Connect(function()
			local q = searchBox.Text:lower()
			for _, it in ipairs(items) do
				it.Button.Visible = q == "" or ItemKey(it.Item):lower():find(q, 1, true) ~= nil
			end
			resize()
		end)
	end

	B.Click.MouseButton1Click:Connect(function()
		if E.Locked then return end
		if E.Opened then E:Close() else E:Open() end
	end)

	function E:Refresh(values)
		E.Values = values or E.Values
		if E.Multi then
			local keep = {}
			for _, x in ipairs(E.Value) do
				for _, nv in ipairs(E.Values) do
					if ItemKey(nv) == ItemKey(x) then table.insert(keep, nv) break end
				end
			end
			E.Value = keep
		elseif E.Value ~= nil then
			local found
			for _, nv in ipairs(E.Values) do
				if ItemKey(nv) == ItemKey(E.Value) then found = nv break end
			end
			E.Value = found
		end
		build()
	end
	function E:SetValues(values) E:Refresh(values) end

	function E:Select(val)
		E.Value = normalize(val)
		restyleItems()
		E._Fire(E.Value)
	end
	E.Set = E.Select
	E.SetValue = E.Select

	build()
	return Finalize(E, cfg, host)
end

--------------------------------------------------------------------------
-- Input / Textarea
--------------------------------------------------------------------------
function Elements.Input(host, cfg)
	local area = cfg.Type == "Textarea"
	local E, B = ElementBase(host, cfg, { Type = "Input", Right = area and 0 or (cfg.Width or 180) })
	E.Value = tostring(cfg.Value or "")
	local focused = false

	local parent
	if area then
		local body = MakeBody(B.Root, true)
		Padding(0, 12, 14, 14, body)
		parent = body
	end
	local field = Field(parent or B.Control, { Size = area and UDim2.new(1, 0, 0, cfg.Height or 96) or UDim2.new(1, 0, 1, 0) })
	local focusStroke = Create("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Thickness = 1.5,
		Theme = {
			Color = "Accent",
			Transparency = function() return focused and 0.1 or 1 end,
		},
		Parent = field,
	})

	local off = 10
	if cfg.InputIcon and GetIcon(cfg.InputIcon) then
		IconImage(cfg.InputIcon, 15, {
			AnchorPoint = Vector2.new(0, area and 0 or 0.5), Position = UDim2.new(0, 9, area and 0 or 0.5, area and 9 or 0),
			Theme = { ImageColor3 = "Placeholder" }, Parent = field,
		})
		off = 30
	end
	local box = Create("TextBox", {
		Name = "Input",
		Text = E.Value,
		PlaceholderText = cfg.Placeholder or "",
		ClearTextOnFocus = cfg.ClearTextOnFocus or false,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, off, 0, area and 8 or 0),
		Size = UDim2.new(1, -(off + 10), 1, area and -16 or 0),
		TextSize = 13,
		Font = "Regular",
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = area and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
		MultiLine = area,
		TextWrapped = area,
		Theme = { TextColor3 = "Text", PlaceholderColor3 = "Placeholder" },
		Parent = field,
	})
	if not area then box.TextTruncate = Enum.TextTruncate.AtEnd end

	local function commit(t)
		if cfg.MaxLength and #t > cfg.MaxLength then t = t:sub(1, cfg.MaxLength) end
		if cfg.Numeric and t ~= "" and not tonumber(t) then
			box.Text = E.Value
			return
		end
		E.Value = t
		E._Fire(t)
	end

	box.Focused:Connect(function()
		if E.Locked then box:ReleaseFocus() return end
		focused = true
		Restyle(focusStroke, 6)
	end)
	box.FocusLost:Connect(function()
		focused = false
		Restyle(focusStroke, 4)
		if E.Locked then box.Text = E.Value return end
		if box.Text ~= E.Value or cfg.Finished then commit(box.Text) end
	end)
	if cfg.Finished == false then
		box:GetPropertyChangedSignal("Text"):Connect(function()
			if focused and box.Text ~= E.Value then commit(box.Text) end
		end)
	end

	function E:Set(t)
		t = t == nil and "" or tostring(t)
		E.Value = t
		box.Text = t
		E._Fire(t)
	end
	E.SetValue = E.Set

	function E:SetPlaceholder(p)
		box.PlaceholderText = p or ""
	end

	E.UIElements.Input = box
	return Finalize(E, cfg, host)
end

--------------------------------------------------------------------------
-- Keybind
--------------------------------------------------------------------------
local function KeyName(k)
	if typeof(k) == "EnumItem" then return k.Name end
	if type(k) == "string" and k ~= "" then return k end
	return "F"
end

function Elements.Keybind(host, cfg)
	local E, B = ElementBase(host, cfg, { Type = "Keybind", Right = 96, Clickable = true })
	E.Value = KeyName(cfg.Value)
	E.Picking = false

	local pill = Field(B.Control, {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.new(0, 0, 0, 28),
		AutomaticSize = Enum.AutomaticSize.X,
		ZIndex = 3,
	})
	Padding(0, 0, 12, 12, pill)
	local pillStroke = Rim(pill, function(th) return E.Picking and 0 or th.ElementStrokeT end)
	local label = Text({
		Name = "Key",
		Text = E.Value,
		Font = "SemiBold",
		TextSize = 13,
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 3,
		Parent = pill,
	})

	local function show()
		label.Text = E.Picking and "..." or E.Value
		Restyle(pillStroke, 6)
	end

	function E:Set(k)
		E.Value = KeyName(k)
		show()
		SafeCall(cfg.ChangedCallback, E.Value)
	end
	E.SetValue = E.Set

	B.Click.MouseButton1Click:Connect(function()
		if E.Locked or E.Picking then return end
		E.Picking = true
		show()
		task.wait(0.15)
		local conn
		conn = UserInputService.InputBegan:Connect(function(input)
			local name
			if input.UserInputType == Enum.UserInputType.Keyboard then
				if input.KeyCode == Enum.KeyCode.Escape then
					name = E.Value
				else
					name = input.KeyCode.Name
				end
			elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
				name = "MouseLeft"
			elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
				name = "MouseRight"
			end
			if name then
				conn:Disconnect()
				E.Picking = false
				E:Set(name)
			end
		end)
	end)

	local conn
	conn = Connect(UserInputService.InputBegan, function(input)
		if not B.Root.Parent then conn:Disconnect() return end
		if E.Picking or E.Locked or UserInputService:GetFocusedTextBox() then return end
		local hit = (input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode.Name == E.Value)
			or (E.Value == "MouseLeft" and input.UserInputType == Enum.UserInputType.MouseButton1)
			or (E.Value == "MouseRight" and input.UserInputType == Enum.UserInputType.MouseButton2)
		if hit then E._Fire(E.Value) end
	end)

	return Finalize(E, cfg, host)
end

