function Tooltip.Attach(gui, text)
	if not text or text == "" then return end
	local token = 0
	gui.MouseEnter:Connect(function()
		token = token + 1
		local my = token
		task.delay(0.45, function()
			if my ~= token then return end
			local f = Tooltip.Get()
			Tooltip.Label.Text = text
			local m = MousePos()
			f.Position = UDim2.new(0, m.X + 14, 0, m.Y + 16)
			f.Visible = true
			Tooltip.Owner = gui
		end)
	end)
	gui.MouseLeave:Connect(function()
		token = token + 1
		if Tooltip.Owner == gui and Tooltip.Frame then
			Tooltip.Frame.Visible = false
		end
	end)
	gui.MouseMoved:Connect(function()
		if Tooltip.Owner == gui and Tooltip.Frame and Tooltip.Frame.Visible then
			local m = MousePos()
			Tooltip.Frame.Position = UDim2.new(0, m.X + 14, 0, m.Y + 16)
		end
	end)
end

