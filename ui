-- Colorpicker (SV 面板 + 色相条 + 透明度条 + HEX)
--------------------------------------------------------------------------
local RAINBOW = (function()
	local pts = {}
	for i = 0, 6 do table.insert(pts, { i / 6, Color3.fromHSV((i % 6) / 6, 1, 1) }) end
	return CS(pts)
end)()

function Elements.Colorpicker(host, cfg)
	local E, B = ElementBase(host, cfg, { Type = "Colorpicker", Right = 46, Clickable = true })
	local color = ToColor(cfg.Value or cfg.Default, RGB(96, 165, 250))
	local transp = cfg.Transparency
	local h, s, v = ToHSV(color)
	E.Value = color
	E.Transparency = transp
	E.Opened = false

	local swatch = Create("Frame", {
		Name = "Swatch",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.new(0, 42, 0, 26),
		BackgroundColor3 = color,
		BackgroundTransparency = transp or 0,
		Parent = B.Control,
	})
	Corner(8, swatch)
	Rim(swatch)

	local PICK_H = 140
	local body = MakeBody(B.Root, false)
	local panel = Create("Frame", { Name = "Panel", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Parent = body })
	Padding(2, 12, 14, 14, panel)

	local sideW = transp ~= nil and 56 or 30
	local sv = Create("TextButton", {
		Name = "SV",
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.new(1, -sideW, 0, PICK_H),
		BackgroundColor3 = Color3.fromHSV(h, 1, 1),
		Parent = panel,
	})
	Corner(10, sv)
	local white = Create("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = WHITE, Parent = sv }, {
		Create("UIGradient", { Transparency = NS({ { 0, 0 }, { 1, 1 } }) }),
	})
	Corner(10, white)
	local black = Create("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = BLACK, ZIndex = 2, Parent = sv }, {
		Create("UIGradient", { Rotation = 90, Transparency = NS({ { 0, 1 }, { 1, 0 } }) }),
	})
	Corner(10, black)
	local svCursor = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.new(0, 14, 0, 14),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = sv,
	})
	Corner(UDim.new(1, 0), svCursor)
	Create("UIStroke", { Color = WHITE, Thickness = 2, Parent = svCursor })

	local function bar(name, xOff)
		local b = Create("TextButton", {
			Name = name,
			Text = "",
			AutoButtonColor = false,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, xOff, 0, 0),
			Size = UDim2.new(0, 18, 0, PICK_H),
			BackgroundColor3 = WHITE,
			Parent = panel,
		})
		Corner(9, b)
		local cur = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.new(1, 4, 0, 6),
			BackgroundTransparency = 1,
			ZIndex = 5,
			Parent = b,
		})
		Corner(3, cur)
		Create("UIStroke", { Color = WHITE, Thickness = 2, Parent = cur })
		return b, cur
	end

	local hue, hueCursor = bar("Hue", transp ~= nil and -26 or 0)
	Create("UIGradient", { Rotation = 90, Color = RAINBOW, Parent = hue })
	local alpha, alphaCursor, alphaGrad
	if transp ~= nil then
		alpha, alphaCursor = bar("Alpha", 0)
		alphaGrad = Create("UIGradient", { Rotation = 90, Transparency = NS({ { 0, 0 }, { 1, 0.95 } }), Parent = alpha })
	end

	local row = Create("Frame", {
		Name = "Row",
		Position = UDim2.new(0, 0, 0, PICK_H + 10),
		Size = UDim2.new(1, 0, 0, 28),
		BackgroundTransparency = 1,
		Parent = panel,
	})
	List(row, 8, true, { VerticalAlignment = Enum.VerticalAlignment.Center })
	local hexField = Field(row, { Size = UDim2.new(0, 96, 1, 0), LayoutOrder = 1 })
	Text({ Text = "#", TextSize = 13, Position = UDim2.new(0, 9, 0, 0), Size = UDim2.new(0, 10, 1, 0), Theme = { TextColor3 = "Placeholder" }, Parent = hexField })
	local hexBox = Create("TextBox", {
		Name = "Hex",
		Text = ColorToHex(color),
		ClearTextOnFocus = false,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 20, 0, 0),
		Size = UDim2.new(1, -24, 1, 0),
		TextSize = 13,
		Font = "SemiBold",
		TextXAlignment = Enum.TextXAlignment.Left,
		Theme = { TextColor3 = "Text" },
		Parent = hexField,
	})
	local rgbLabel = Text({
		Name = "RGB", TextSize = 12, Font = "Regular", LayoutOrder = 2,
		Size = UDim2.new(1, -104, 1, 0), Theme = { TextColor3 = "SubText" }, Parent = row,
	})

	local function update(fire)
		color = Color3.fromHSV(h, s, v)
		E.Value = color
		E.Transparency = transp
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		swatch.BackgroundColor3 = color
		swatch.BackgroundTransparency = transp or 0
		svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
		hueCursor.Position = UDim2.new(0.5, 0, h, 0)
		if alpha then
			alpha.BackgroundColor3 = color
			alphaCursor.Position = UDim2.new(0.5, 0, transp, 0)
		end
		hexBox.Text = ColorToHex(color)
		rgbLabel.Text = string.format("RGB  %d, %d, %d%s",
			math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5),
			transp ~= nil and string.format("   A %d%%", math.floor((1 - transp) * 100 + 0.5)) or "")
		if fire then E._Fire(color, transp) end
	end

	local function rel(gui, input)
		local p, sz = gui.AbsolutePosition, gui.AbsoluteSize
		return Clamp01((input.Position.X - p.X) / math.max(sz.X, 1)), Clamp01((input.Position.Y - p.Y) / math.max(sz.Y, 1))
	end
	local function svMove(input)
		s, v = rel(sv, input)
		v = 1 - v
		update(true)
	end
	OnDrag(sv, function(i) if E.Locked then return false end svMove(i) end, svMove)
	local function hueMove(input)
		local _, y = rel(hue, input)
		h = math.min(y, 0.999)
		update(true)
	end
	OnDrag(hue, function(i) if E.Locked then return false end hueMove(i) end, hueMove)
	if alpha then
		local function alphaMove(input)
			local _, y = rel(alpha, input)
			transp = y
			update(true)
		end
		OnDrag(alpha, function(i) if E.Locked then return false end alphaMove(i) end, alphaMove)
	end

	hexBox.FocusLost:Connect(function()
		local txt = hexBox.Text:gsub("#", "")
		local ok, c = pcall(Color3.fromHex, txt)
		if ok and c and not E.Locked then
			h, s, v = ToHSV(c)
			update(true)
		else
			hexBox.Text = ColorToHex(color)
		end
	end)

	function E:Open()
		if E.Locked then return end
		E.Opened = true
		Spring(body, { Size = UDim2.new(1, 0, 0, PICK_H + 52) }, 4, 0.8)
	end
	function E:Close()
		E.Opened = false
		Spring(body, { Size = UDim2.new(1, 0, 0, 0) }, 4.5, 1)
	end
	E._OnLock = function() E:Close() end

	B.Click.MouseButton1Click:Connect(function()
		if E.Locked then return end
		if E.Opened then E:Close() else E:Open() end
	end)

	function E:Update(c, t)
		c = ToColor(c, color)
		h, s, v = ToHSV(c)
		if t ~= nil then transp = t end
		update(true)
	end
	E.Set = E.Update
	E.SetValue = E.Update
	E.SetValueRGB = E.Update

	update(false)
	return Finalize(E, cfg, host)
end

