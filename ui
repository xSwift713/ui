	-- 窗口方法
	------------------------------------------------------------------
	local hintShown = false
	local animToken = 0

	-- 悬浮按钮中心相对窗口中心的偏移 (窗口本地坐标); 最小化时窗口缩进按钮, 打开时从按钮弹出
	local function BubbleOffset()
		if not (openBtn and openBtn.Visible) then return nil end
		local gs = openGui.AbsoluteSize
		-- 图层刚创建时可能还没算出尺寸, 退回用视口尺寸 (悬浮按钮图层本就覆盖整个视口)
		if gs.X <= 0 and workspace.CurrentCamera then gs = workspace.CurrentCamera.ViewportSize end
		local rs = root.AbsoluteSize
		if gs.X <= 0 or rs.X <= 0 then return nil end
		local p = openBtn.Position
		local inset = GetInset()
		-- 悬浮按钮图层覆盖顶栏, 主界面不覆盖, 换算到主界面坐标
		local bx = gs.X * p.X.Scale + p.X.Offset - inset.X
		local by = gs.Y * p.Y.Scale + p.Y.Offset + 22 - inset.Y
		local rp = root.AbsolutePosition
		local s = math.max(userScale.Scale, 0.01)
		return (bx - (rp.X + rs.X / 2)) / s, (by - (rp.Y + rs.Y / 2)) / s
	end

	-- 动画只用 UIScale 缩放 + 位移, 不做整体透明度渐变 (那需要 CanvasGroup, 代价高)
	function W:Open()
		if W.Destroyed then return end
		animToken = animToken + 1
		if W.Closed then
			local dx, dy = BubbleOffset()
			if dx then Set(scaler, { Position = UDim2.new(0.5, dx, 0.5, dy) }) end
		end
		W.Closed = false
		root.Visible = true
		-- 内容等外壳展开到 85% 再显示 (见 _Step)
		if not canvas.Visible then W._reveal = true end
		Spring(animScale, { Scale = 1 }, 3, 0.7)
		Spring(scaler, { Position = UDim2.new(0.5, 0, 0.5, 0) }, 3, 0.85)
		Restyle(shadow, 4)
		if openBtn then openBtn.Visible = false end
		for _, fn in ipairs(W._open) do task.spawn(SafeCall, fn) end
	end

	function W:Close()
		if W.Destroyed or W.Closed then return end
		W.Closed = true
		animToken = animToken + 1
		local my = animToken
		-- 先藏起内容, 只让空的玻璃外壳缩进悬浮按钮
		W._reveal = false
		canvas.Visible = false
		local bubble = ShouldShowOpenButton() and openBtn
		if bubble then
			openBtn.Visible = true
			Set(W._openScale, { Scale = 0.5 })
			Spring(W._openScale, { Scale = 1 }, 3.4, 0.55)
		end
		local dx, dy = BubbleOffset()
		Spring(animScale, { Scale = 0 }, 4.2, 1)
		if dx then Spring(scaler, { Position = UDim2.new(0.5, dx, 0.5, dy) }, 4.2, 1) end
		Restyle(shadow, 6)
		task.delay(0.3, function()
			if my == animToken and W.Closed and not W.Destroyed then root.Visible = false end
		end)
		if not bubble and not hintShown and W.ToggleKey then
			hintShown = true
			WindUI:Notify({
				Title = WindUI.Strings.Hidden,
				Content = string.format(WindUI.Strings.Reopen, W.ToggleKey.Name),
				Duration = 3,
			})
		end
		for _, fn in ipairs(W._close) do task.spawn(SafeCall, fn) end
		return W
	end
	W.Minimize = W.Close

	function W:Toggle()
		if W.Closed then W:Open() else W:Close() end
	end

	function W:Destroy()
		if W.Destroyed then return end
		for _, fn in ipairs(W._destroy) do SafeCall(fn) end
		W.Destroyed = true
		W:_SetAcrylic(false)
		W._reveal = false
		canvas.Visible = false
		Spring(animScale, { Scale = 0 }, 4.2, 1)
		task.delay(0.3, function()
			gui:Destroy()
			openGui:Destroy()
		end)
		for _, c in ipairs(W._conns) do pcall(function() c:Disconnect() end) end
		local i = Find(WindUI.Windows, W)
		if i then table.remove(WindUI.Windows, i) end
		if WindUI.Window == W then WindUI.Window = WindUI.Windows[#WindUI.Windows] end
	end

