-- 通用对话框 (窗口内 Dialog / 全屏 Popup 共用)
local function ShowDialog(parent, cfg, z, radius)
	z = z or 60
	local D = { Closed = false }
	local layer = Create("Frame", {
		Name = "DialogLayer",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		ZIndex = z,
		Parent = parent,
	})
	local backdrop = Create("TextButton", {
		Name = "Backdrop",
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		ZIndex = z,
		Theme = { BackgroundColor3 = "Backdrop" },
		Parent = layer,
	})
	-- 窗口内对话框: 遮罩跟窗口一样圆角 (窗口不再用 CanvasGroup 裁剪)
	if radius then Corner(radius, backdrop) end
	local card = Create("CanvasGroup", {
		Name = "Dialog",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0, cfg.Width or 340, 0, 120),
		GroupTransparency = 1,
		ZIndex = z + 1,
		Theme = {
			BackgroundColor3 = "Glass",
			BackgroundTransparency = function(th) return math.min(GlassT(th), 0.1) end,
		},
		Parent = layer,
	})
	Corner(18, card)
	Sheen(card, 18, z + 1)
	local rimHolder = Create("Frame", {
		Position = UDim2.new(0, 1, 0, 1), Size = UDim2.new(1, -2, 1, -2),
		BackgroundTransparency = 1, ZIndex = z + 2, Parent = card,
	})
	Corner(17, rimHolder)
	Rim(rimHolder)
	local scale = Create("UIScale", { Scale = 0.88, Parent = card })

	local content = Create("Frame", {
		Name = "Content",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		ZIndex = z + 3,
		Parent = card,
	})
	Padding(20, 18, 20, 20, content)
	List(content, 10)
	FollowHeight(card, content)

	local titleRow = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1, LayoutOrder = 1, ZIndex = z + 3, Parent = content,
	})
	local tOff = 0
	if cfg.Icon and GetIcon(cfg.Icon) then
		IconImage(cfg.Icon, 22, { ZIndex = z + 3, Theme = { ImageColor3 = "Accent" }, Parent = titleRow })
		tOff = 32
	end
	Text({
		Text = cfg.Title or "", Font = "SemiBold", TextSize = 18, ZIndex = z + 3,
		Position = UDim2.new(0, tOff, 0, 0), Size = UDim2.new(1, -tOff, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, Parent = titleRow,
	})
	if cfg.Content and cfg.Content ~= "" then
		Text({
			Text = tostring(cfg.Content), TextSize = 14, Font = "Regular", ZIndex = z + 3, LayoutOrder = 2,
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true,
			Theme = { TextColor3 = "SubText" }, Parent = content,
		})
	end
	local row = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1, LayoutOrder = 3, ZIndex = z + 3, Parent = content,
	})
	List(row, 8, true, { HorizontalAlignment = Enum.HorizontalAlignment.Right })

	function D:Close()
		if D.Closed then return end
		D.Closed = true
		Spring(backdrop, { BackgroundTransparency = 1 }, 4, 1)
		Spring(scale, { Scale = 0.92 }, 5, 1)
		Tween(card, 0.15, { GroupTransparency = 1 })
		task.delay(0.25, function() layer:Destroy() end)
	end

	for i, b in ipairs(cfg.Buttons or {}) do
		local btn = PillButton(row, b, i)
		btn.ZIndex = z + 4
		for _, d in ipairs(btn:GetDescendants()) do
			if d:IsA("GuiObject") then d.ZIndex = z + 4 end
		end
		btn.MouseButton1Click:Connect(function()
			D:Close()
			task.spawn(SafeCall, b.Callback)
		end)
	end

	Spring(backdrop, { BackgroundTransparency = WindUI.Theme.BackdropT }, 4, 1)
	Spring(scale, { Scale = 1 }, 3.4, 0.62)
	Tween(card, 0.2, { GroupTransparency = 0 })
	return D
end

