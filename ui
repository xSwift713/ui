		Padding(8, 8, 8, 8, inner)
	end
	List(inner, 8)

	local S = NewHost(window, tab, inner, {
		__type = "Section",
		Title = cfg.Title,
		Opened = cfg.Opened ~= false,
		Count = 0,
		ElementFrame = frame,
		UIElements = { Main = frame, Header = header, Title = title, Body = body },
	})
	local animating = 0

	function S:_Added()
		S.Count = S.Count + 1
		chevron.Visible = true
		chevron.Rotation = S.Opened and 0 or -90
		if S.Opened then body.Visible = true end
	end

	function S:Open()
		if S.Opened then return end
		S.Opened = true
		if S.Count == 0 then return end
		animating = animating + 1
		local my = animating
		body.Visible = true
		body.AutomaticSize = Enum.AutomaticSize.None
		body.ClipsDescendants = true
		Spring(body, { Size = UDim2.new(1, 0, 0, inner.AbsoluteSize.Y / EffectiveScale(body)) }, 3.6, 0.85)
		Spring(chevron, { Rotation = 0 }, 4.5, 0.65)
		task.delay(0.45, function()
			if my == animating and S.Opened then
				Set(body, { Size = UDim2.new(1, 0, 0, 0) })
				body.AutomaticSize = Enum.AutomaticSize.Y
				body.ClipsDescendants = false
			end
		end)
	end

	function S:Close()
		if not S.Opened then return end
		S.Opened = false
		if S.Count == 0 then return end
		animating = animating + 1
		local my = animating
		local hgt = body.AbsoluteSize.Y / EffectiveScale(body)
		body.AutomaticSize = Enum.AutomaticSize.None
		body.ClipsDescendants = true
		Set(body, { Size = UDim2.new(1, 0, 0, hgt) })
		Spring(body, { Size = UDim2.new(1, 0, 0, 0) }, 4, 1)
		Spring(chevron, { Rotation = -90 }, 4.5, 0.65)
		task.delay(0.35, function()
			if my == animating and not S.Opened then body.Visible = false end
		end)
	end

	header.MouseButton1Click:Connect(function()
		if S.Count == 0 then return end
		if S.Opened then S:Close() else S:Open() end
	end)

	function S:SetTitle(t)
		S.Title = t
		title.Text = t or ""
	end
	function S:SetDesc(d)
		desc.Text = d or ""
		desc.Visible = d ~= nil and d ~= ""
	end
	function S:SetVisible(v) frame.Visible = v and true or false end
	function S:Destroy() frame:Destroy() end

	self:_Added(S)
	return S
end
