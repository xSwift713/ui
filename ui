-- 兼容 WindUI 主题格式: { Name, Accent, Background, Outline, Text, Placeholder, Button, Icon }
function WindUI:AddTheme(t)
	assert(type(t) == "table" and t.Name, "AddTheme: Name required")
	local glass = ToColor(t.Glass or t.Background, RGB(14, 16, 26))
	local isDark = t.Dark
	if isDark == nil then
		isDark = (glass.R * 0.299 + glass.G * 0.587 + glass.B * 0.114) < 0.55
	end
	local over = { Glass = glass }
	for k, v in pairs(t) do
		if k ~= "Name" and k ~= "Background" then
			over[k] = (typeof(v) == "Color3" or type(v) ~= "string") and v or ToColor(v, v)
		end
	end
	over.Accent = ToColor(t.Accent, RGB(96, 165, 250))
	over.Accent2 = ToColor(t.Accent2, over.Accent)
	if t.Outline then over.Stroke = ToColor(t.Outline, WHITE) end
	if t.Placeholder and not t.SubText then over.SubText = ToColor(t.Placeholder, nil) end
	if t.Text then over.Text = ToColor(t.Text, nil) end
	RegisterTheme(MakeTheme(t.Name, isDark and DarkBase or LightBase, over))
	return self.Themes[t.Name]
end

