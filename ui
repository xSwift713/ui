-- 把 EnumItem / "RightShift" 之类的字符串转成 Enum.KeyCode; 无效值 / "None" / false 返回 nil (= 不绑定快捷键)
function WindUI.ParseKey(k)
	if typeof(k) == "EnumItem" then return k end
	if type(k) == "string" and k ~= "" then
		local ok, e = pcall(function() return Enum.KeyCode[k] end)
		if ok and typeof(e) == "EnumItem" then return e end
	end
	return nil
end

