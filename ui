-- AbsolutePosition / AbsoluteSize 是经过所有祖先 UIScale 缩放后的屏幕像素,
-- 换算回本地偏移时要除以这个累计缩放
local function EffectiveScale(gui)
	local s = 1
	local node = gui
	while node and node.ClassName ~= "ScreenGui" do
		local sc = node:FindFirstChildWhichIsA("UIScale")
		if sc then s = s * sc.Scale end
		node = node.Parent
	end
	return math.max(s, 0.01)
end

-- 让 frame 的高度跟随 source 的实际高度 (source 为其内部的 AutomaticSize 内容框)。
-- 铺满型子元素 (Size.Y 带比例) 不能放进 AutomaticSize 容器: 它的高度取自容器自身,
-- 带正偏移时每次重算都会把容器再撑高一截 (无限拉长)。外层改为固定高度后就安全了。
local function FollowHeight(frame, source, extra)
	-- 缩放动画期间每帧都会触发, 所以这里要便宜: 用 frame 自身 "屏幕高度 / 本地高度"
	-- 得到累计缩放, 不必逐层向上查找 UIScale
	local function update()
		local cur = frame.Size
		local abs = source.AbsoluteSize.Y
		local s
		if cur.Y.Scale == 0 and cur.Y.Offset > 0 and frame.AbsoluteSize.Y > 0 then
			s = frame.AbsoluteSize.Y / cur.Y.Offset
		else
			s = EffectiveScale(source)
		end
		-- 窗口缩到几乎看不见时不更新, 等动画回来再算
		if s < 0.05 or abs <= 0 then return end
		local h = abs / s + (extra or 0)
		if math.abs(cur.Y.Offset - h) > 0.5 or cur.Y.Scale ~= 0 then
			frame.Size = UDim2.new(cur.X.Scale, cur.X.Offset, 0, h)
		end
	end
	source:GetPropertyChangedSignal("AbsoluteSize"):Connect(update)
	update()
end

-- 点击水波纹 (fx 为裁剪层)
local function Ripple(fx)
	local s = EffectiveScale(fx)
	local m = MousePos()
	local p, sz = fx.AbsolutePosition, fx.AbsoluteSize
	local lx, ly = (m.X - p.X) / s, (m.Y - p.Y) / s
	local w, h = sz.X / s, sz.Y / s
	if lx < 0 or ly < 0 or lx > w or ly > h then lx, ly = w / 2, h / 2 end
	local d = math.max(w, h) * 2.2
	local r = Create("Frame", {
		Name = "Ripple",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, lx, 0, ly),
		Size = UDim2.new(0, 0, 0, 0),
		BackgroundTransparency = 0.8,
		BorderSizePixel = 0,
		ZIndex = fx.ZIndex,
		Theme = { BackgroundColor3 = function(th) return th.Dark and WHITE or th.Accent end },
		Parent = fx,
	})
	Corner(UDim.new(1, 0), r)
	Tween(r, TweenInfo.new(0.6, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, d, 0, d),
		BackgroundTransparency = 1,
	})
	task.delay(0.65, function() r:Destroy() end)
end

