function WindUI:Gradient(stops, props)
	local cps, tps = {}, {}
	local keys = {}
	for k in pairs(stops) do table.insert(keys, tonumber(k)) end
	table.sort(keys)
	for _, k in ipairs(keys) do
		local s = stops[tostring(k)] or stops[k]
		table.insert(cps, { k / 100, ToColor(s.Color, WHITE) })
		table.insert(tps, { k / 100, s.Transparency or 0 })
	end
	local g = { Color = CS(cps), Transparency = NS(tps) }
	for k, v in pairs(props or {}) do g[k] = v end
	return g
end

