--------------------------------------------------------------------------
-- 基础工具
--------------------------------------------------------------------------
local function Connect(signal, fn)
	local c = signal:Connect(fn)
	table.insert(WindUI.Connections, c)
	return c
end

local function SafeCall(fn, ...)
	if type(fn) ~= "function" then return end
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[LiquidGlass] callback error: " .. tostring(err))
	end
	return ok, err
end

local function Find(list, value)
	for i, v in ipairs(list) do
		if v == value then return i end
	end
	return nil
end

local function Clamp01(x)
	if x < 0 then return 0 elseif x > 1 then return 1 end
	return x
end

local function ToColor(c, fallback)
	if typeof(c) == "Color3" then return c end
	if type(c) == "string" then
		local ok, col = pcall(Color3.fromHex, c)
		if ok and col then return col end
	end
	return fallback
end

local function GetInset()
	if GuiService then
		local ok, a = pcall(function() return GuiService:GetGuiInset() end)
		if ok and typeof(a) == "Vector2" then return a end
	end
	return Vector2.new(0, 0)
end

local function MousePos()
	local ok, m = pcall(function() return UserInputService:GetMouseLocation() end)
	if not ok or typeof(m) ~= "Vector2" then return Vector2.new(0, 0) end
	return m - GetInset()
end

local function IsTouch()
	local ok, t = pcall(function()
		return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	end)
	return ok and t or false
end

local function IsClick(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local FontCache = {}
local function GetFont(weight)
	weight = weight or "Medium"
	local key = WindUI.Font .. "/" .. weight
	if FontCache[key] ~= nil then return FontCache[key] or nil end
	local ok, f = pcall(function()
		local w = Enum.FontWeight[weight]
		if WindUI.Font:find("rbxasset") then
			return Font.new(WindUI.Font, w)
		end
		return Font.fromName(WindUI.Font, w)
	end)
	if not ok or not f then
		ok, f = pcall(function()
			return Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight[weight])
		end)
	end
	FontCache[key] = (ok and f) or false
	return FontCache[key] or nil
end

--------------------------------------------------------------------------
-- 弹簧动画引擎 (液态感的核心: 带回弹的连续运动, 可随时改目标不打断速度)
--------------------------------------------------------------------------
local Springs = {}
local SpringHooks = {}

local function Pack(v)
	local t = typeof(v)
	if t == "number" then return { v }, t
	elseif t == "UDim2" then return { v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset }, t
	elseif t == "Color3" then return { v.R, v.G, v.B }, t
	elseif t == "Vector2" then return { v.X, v.Y }, t
	elseif t == "UDim" then return { v.Scale, v.Offset }, t
	end
	return nil, t
end

local function Unpack(a, t)
	if t == "number" then return a[1]
	elseif t == "UDim2" then return UDim2.new(a[1], a[2], a[3], a[4])
	elseif t == "Color3" then return Color3.new(Clamp01(a[1]), Clamp01(a[2]), Clamp01(a[3]))
	elseif t == "Vector2" then return Vector2.new(a[1], a[2])
	elseif t == "UDim" then return UDim.new(a[1], a[2])
	end
end

local function SetProp(obj, prop, value)
	obj[prop] = value
end

-- freq: 振动频率 (越大越快), damp: 阻尼比 (<1 回弹, 1 无回弹)
local function Spring(obj, props, freq, damp)
	if obj == nil then return end
	freq = freq or 4
	damp = damp or 1
	local states = Springs[obj]
	for prop, goal in pairs(props) do
		local g, t = Pack(goal)
		if not g then
			if states then states[prop] = nil end
			obj[prop] = goal
		else
			if not states then
				states = {}
				Springs[obj] = states
			end
			local st = states[prop]
			if not st or st.t ~= t then
				local cur = Pack(obj[prop])
				st = { x = cur or g, v = {}, t = t }
				for i = 1, #g do st.v[i] = 0 end
				states[prop] = st
			end
			st.g = g
			st.f = freq
			st.d = damp
		end
	end
end

-- 立即设置 (同时取消这些属性上的弹簧)
local function Set(obj, props)
	local states = Springs[obj]
	for prop, v in pairs(props) do
		if states then states[prop] = nil end
		obj[prop] = v
	end
end

local function StepSprings(dt)
	if dt > 0.05 then dt = 0.05 end
	for obj, states in pairs(Springs) do
		for prop, st in pairs(states) do
			local w = 6.283185 * st.f
			local k, c = w * w, 2 * st.d * w
			-- 子步长保证 w*h <= 0.5, 高频弹簧也不会数值发散
			local n = math.max(1, math.ceil(dt * 240), math.ceil(dt * w * 2))
			local h = dt / n
			local x, v, g = st.x, st.v, st.g
			local done = true
			for i = 1, #g do
				local xi, vi, gi = x[i], v[i], g[i]
				for _ = 1, n do
					vi = vi + (-k * (xi - gi) - c * vi) * h
					xi = xi + vi * h
				end
				if math.abs(xi - gi) > 1e-3 or math.abs(vi) > 1e-2 then
					done = false
				end
				x[i], v[i] = xi, vi
			end
			local value
			if done then
				value = Unpack(g, st.t)
				states[prop] = nil
			else
				value = Unpack(x, st.t)
			end
			if not pcall(SetProp, obj, prop, value) then
				states[prop] = nil
			end
		end
		local hook = SpringHooks[obj]
		if hook then hook(obj) end
		if next(states) == nil then
			Springs[obj] = nil
		end
	end
end

local function Tween(obj, info, props)
	local states = Springs[obj]
	if states then
		for p in pairs(props) do states[p] = nil end
	end
	if type(info) == "number" then
		info = TweenInfo.new(info, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	end
	local tw = TweenService:Create(obj, info, props)
	tw:Play()
	return tw
end

--------------------------------------------------------------------------
-- 主题绑定 (属性 -> 主题键 / 函数), 切换主题时全部平滑过渡
--------------------------------------------------------------------------
local Bindings = {}
local ThemeListeners = {}

local function Resolve(key, theme)
	theme = theme or WindUI.Theme
	if type(key) == "function" then return key(theme) end
	return theme[key]
end

local function Bind(inst, map)
	local b = Bindings[inst]
	if not b then
		b = {}
		Bindings[inst] = b
	end
	for prop, key in pairs(map) do
		b[prop] = key
		local v = Resolve(key)
		if v ~= nil then
			if Springs[inst] then Springs[inst][prop] = nil end
			inst[prop] = v
		end
	end
end

-- 让已绑定的属性弹向当前解析值 (用于 hover / 选中 / 主题变化)
local function Restyle(inst, freq, damp)
	local b = Bindings[inst]
	if not b then return end
	local goals = {}
	for prop, key in pairs(b) do
		local v = Resolve(key)
		if v ~= nil then
			if Pack(v) then
				goals[prop] = v
			else
				Set(inst, { [prop] = v })
			end
		end
	end
	Spring(inst, goals, freq or 5, damp or 1)
end

local function ApplyTheme(instant)
	for inst in pairs(Bindings) do
		local alive = true
		if typeof(inst) == "Instance" then
			alive = inst.Parent ~= nil
		end
		if not alive then
			Bindings[inst] = nil
		elseif instant then
			for prop, key in pairs(Bindings[inst]) do
				local v = Resolve(key)
				if v ~= nil then Set(inst, { [prop] = v }) end
			end
		else
			Restyle(inst, 1.8, 1)
		end
	end
	for _, fn in ipairs(ThemeListeners) do
		task.spawn(SafeCall, fn, WindUI.CurrentThemeName)
	end
end

--------------------------------------------------------------------------
-- 实例构造
--------------------------------------------------------------------------
local function Create(class, props, children)
	local inst = Instance.new(class)
	local parent, theme
	if props then
		for k, v in pairs(props) do
			if k == "Parent" then
				parent = v
			elseif k == "Theme" then
				theme = v
			elseif k == "Font" and type(v) == "string" then
				local f = GetFont(v)
				if f then inst.FontFace = f end
			else
				inst[k] = v
			end
		end
	end
	if theme then Bind(inst, theme) end
	if children then
		for _, c in ipairs(children) do c.Parent = inst end
	end
	if parent then inst.Parent = parent end
	return inst
end

local function Corner(r, parent)
	return Create("UICorner", { CornerRadius = typeof(r) == "UDim" and r or UDim.new(0, r or 10), Parent = parent })
end

local function Padding(t, b, l, r, parent)
	return Create("UIPadding", {
		PaddingTop = UDim.new(0, t or 0), PaddingBottom = UDim.new(0, b or 0),
		PaddingLeft = UDim.new(0, l or 0), PaddingRight = UDim.new(0, r or 0),
		Parent = parent,
	})
end

local function List(parent, pad, horizontal, props)
	local p = {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, pad or 0),
		FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
		Parent = parent,
	}
	if props then for k, v in pairs(props) do p[k] = v end end
	return Create("UIListLayout", p)
end

local function NS(points)
	local kps = {}
	for _, p in ipairs(points) do
		table.insert(kps, NumberSequenceKeypoint.new(p[1], p[2]))
	end
	return NumberSequence.new(kps)
end

local function CS(points)
	local kps = {}
	for _, p in ipairs(points) do
		table.insert(kps, ColorSequenceKeypoint.new(p[1], p[2]))
	end
	return ColorSequence.new(kps)
end

local function AccentSequence(theme)
	theme = theme or WindUI.Theme
	return CS({ { 0, theme.Accent }, { 1, theme.Accent2 } })
end

