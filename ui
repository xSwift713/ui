	------------------------------------------------------------------
	-- Tab
	------------------------------------------------------------------
	function W:Tab(a, b, parentContainer)
		local tcfg = NormalizeArgs(a, b)
		local index = #W.Tabs + 1
		local tab = NewHost(W, nil, nil, {
			__type = "Tab",
			Title = tcfg.Title or ("Tab " .. index),
			Icon = tcfg.Icon,
			Desc = tcfg.Desc,
			Index = index,
			Locked = false,
			Selected = false,
			Elements = {},
			SubTabs = {},
			UIElements = {},
			_PageY = 0,
		})
		setmetatable(tab, TabMT)
		local st = { Hover = false }

		local btn = Create("Frame", {
			Name = "Tab",
			Size = UDim2.new(1, 0, 0, 36),
			BackgroundTransparency = 1,
			LayoutOrder = NextSideOrder(),
			ZIndex = 4,
			Parent = parentContainer or tabHolder,
		})
		local hover = Create("Frame", {
			Name = "Hover",
			Size = UDim2.new(1, 0, 1, 0),
			ZIndex = 4,
			Theme = {
				BackgroundColor3 = "Element",
				BackgroundTransparency = function(t)
					if st.Hover and not tab.Selected then return t.Dark and 0.94 or 0.6 end
					return 1
				end,
			},
			Parent = btn,
		})
		Corner(10, hover)
		local tOff = 14
		local icon
		if tcfg.Icon and GetIcon(tcfg.Icon) then
			icon = IconImage(tcfg.Icon, 17, {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 14, 0.5, 0),
				ZIndex = 5,
				Theme = { ImageColor3 = function(t)
					if not IsLucide(tcfg.Icon) then return WHITE end
					if not tab.Selected then return t.SubText end
					return t.Dark and Mix(t.Accent, WHITE, 0.35) or t.Accent
				end },
				Parent = btn,
			})
			tOff = 40
		end
		local label = Text({
			Name = "Title",
			Text = tab.Title,
			TextSize = 14,
			Position = UDim2.new(0, tOff, 0, 0),
			Size = UDim2.new(1, -(tOff + 8), 1, 0),
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 5,
			Theme = {
				TextColor3 = function(t) return tab.Selected and t.Text or t.SubText end,
				TextTransparency = function() return tab.Locked and 0.5 or 0 end,
			},
			Parent = btn,
		})
		local click = Create("TextButton", {
			Name = "Click",
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 1, 0),
			ZIndex = 6,
			Parent = btn,
		})
		click.MouseEnter:Connect(function() st.Hover = true Restyle(hover, 6) end)
		click.MouseLeave:Connect(function() st.Hover = false Restyle(hover, 4) end)
		click.MouseButton1Click:Connect(function() W:SelectTab(tab) end)

		local function restyleButton()
			Restyle(hover, 5)
			Restyle(label, 5)
			if icon then Restyle(icon, 5) end
		end
		tab._Restyle = restyleButton

		-- 内容页 (含 meyyUI 风格的固定子标签栏)
		local tabFrame = Create("Frame", {
			Name = "TabPage",
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			Visible = false,
			ZIndex = 3,
			Parent = pages,
		})
		local subBar = Create("ScrollingFrame", {
			Name = "SubTabBar",
			Size = UDim2.new(1, -8, 0, SUBBAR - 6),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 0,
			CanvasSize = UDim2.new(0, 0, 0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.X,
			Visible = false,
			ZIndex = 30,
			Parent = tabFrame,
		})
		List(subBar, 6, true, { VerticalAlignment = Enum.VerticalAlignment.Center })
		Padding(0, 0, 2, 2, subBar)
		local page = Create("ScrollingFrame", {
			Name = "Page",
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 3,
			ScrollBarImageTransparency = 0.45,
			CanvasSize = UDim2.new(0, 0, 0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ZIndex = 3,
			Theme = { ScrollBarImageColor3 = "Accent" },
			Parent = tabFrame,
		})
		Padding(4, 16, 2, 10, page)
		List(page, 8)

		tab.Frame = btn
		tab.Container = page
		tab.UIElements.Main = btn
		tab.UIElements.Page = page
		tab.UIElements.Container = tabFrame
		tab.UIElements.SubTabBar = subBar
		tab._SubBar = subBar
		table.insert(W.Tabs, tab)

		if tcfg.Locked then tab:Lock() end
		if index == 1 then W:SelectTab(tab) end
		return tab
	end
	W.AddTab = W.Tab
	W.CreateTab = W.Tab

	function W:SelectTab(t)
		local tab = type(t) == "number" and W.Tabs[t] or t
		if type(tab) ~= "table" or tab.Locked then return end
		local same = W.SelectedTab == tab
		W.SelectedTab = tab
		W.CurrentTab = tab.Index
		for _, other in ipairs(W.Tabs) do
			other.Selected = other == tab
			other.UIElements.Container.Visible = other == tab
			other._Restyle()
		end
		if not same then
			local page = tab.UIElements.Page
			Set(page, { Position = UDim2.new(0, 0, 0, tab._PageY + 22) })
			Spring(page, { Position = UDim2.new(0, 0, 0, tab._PageY) }, 3, 0.72)
			pageTitle.Text = tab.Title
			Set(pageTitle, { TextTransparency = 1, Position = UDim2.new(0, 14, 0, 0) })
			Spring(pageTitle, { TextTransparency = 0 }, 3, 1)
			Spring(pageTitle, { Position = UDim2.new(0, 4, 0, 0) }, 3, 0.8)
			if W._hasSelected then Sweep() end
		end
		W._hasSelected = true
		W:_MoveIndicator(false)
		if W._onTab then task.spawn(SafeCall, W._onTab, tab.Index) end
	end

	function W:OnTabChange(fn) W._onTab = fn end
	W.OnChange = W.OnTabChange

	function W:_SetPageTitle(tab)
		if W.SelectedTab == tab then pageTitle.Text = tab.Title end
	end

	-- 搜索: 过滤标签 + 当前标签下的元素
	function W:_Search(q)
		q = (q or ""):lower()
		for _, tab in ipairs(W.Tabs) do
			local titleHit = q == "" or tab.Title:lower():find(q, 1, true) ~= nil
			local anyHit = false
			for _, E in ipairs(tab.Elements) do
				local hit = q == ""
					or tostring(E.Title or ""):lower():find(q, 1, true) ~= nil
					or tostring(E.Desc or ""):lower():find(q, 1, true) ~= nil
				if hit then anyHit = true end
				E._SearchHit = hit
			end
			for _, E in ipairs(tab.Elements) do
				local show = E._SearchHit or (titleHit and not anyHit)
				E.ElementFrame.Visible = show and E.Visible ~= false
			end
			tab.Frame.Visible = titleHit or anyHit
		end
		task.defer(function() W:_MoveIndicator(false) end)
	end
	if searchBox then
		searchBox:GetPropertyChangedSignal("Text"):Connect(function() W:_Search(searchBox.Text) end)
	end

	------------------------------------------------------------------
	-- 背景模糊
	------------------------------------------------------------------
	function W:_SetAcrylic(on)
		if on and not W._blurPart and not W.Destroyed then
			local ok = pcall(function()
				local part, mesh = Acrylic.New()
				part.Parent = workspace.CurrentCamera or workspace
				W._blurPart, W._blurMesh = part, mesh
			end)
			if ok then
				Acrylic.Users = Acrylic.Users + 1
				pcall(Acrylic.EnableDOF)
			end
		elseif not on and W._blurPart then
			pcall(function() W._blurPart:Destroy() end)
			W._blurPart, W._blurMesh = nil, nil
			Acrylic.Users = math.max(Acrylic.Users - 1, 0)
			if Acrylic.Users == 0 then pcall(Acrylic.DisableDOF) end
		end
	end

	------------------------------------------------------------------
	-- 每帧: 内容显现 / 高光跟随鼠标 / 模糊跟随
	------------------------------------------------------------------
	function W:_Step(dt)
		if W.Destroyed then return end
		local visible = root.Visible and not W.Closed
		if visible then
			-- 外壳快展开完时显示内容, 再做一个只平移的小入场 (平移不触发文字重排)
			if W._reveal and animScale.Scale >= 0.85 then
				W._reveal = false
				Set(canvas, { Position = UDim2.new(0, 0, 0, 8) })
				canvas.Visible = true
				Spring(canvas, { Position = UDim2.new(0, 0, 0, 0) }, 4, 0.8)
			end
		end
		if W._blurPart then
			W._blurPart.Transparency = visible and 0.98 or 1
			if visible then pcall(Acrylic.Update, W._blurPart, W._blurMesh, shell) end
		end
		if openBtn and openBtn.Visible and W._openStrokeGrad then
			W._openStrokeGrad.Rotation = (W._openStrokeGrad.Rotation + dt * 90) % 360
		end
	end

	------------------------------------------------------------------
	-- 顶栏按钮
	------------------------------------------------------------------
	local closeFn = function()
		W:Dialog({
			Title = WindUI.Strings.CloseTitle,
			Content = WindUI.Strings.CloseContent,
			Icon = "alert-triangle",
			Buttons = {
				{ Title = WindUI.Strings.Cancel, Variant = "Secondary" },
				{ Title = WindUI.Strings.Close, Variant = "Primary", Callback = function() W:Destroy() end },
			},
		})
	end
	if mac then
		TopButton(buttons, "Close", "x", 1, closeFn, true, true)
		TopButton(buttons, "Minimize", "minus", 2, function() W:Close() end, false, true)
		TopButton(buttons, "Fullscreen", "maximize-2", 3, function() W:ToggleFullscreen() end, false, true)
	else
		TopButton(buttons, "Minimize", "minus", 1, function() W:Close() end)
		TopButton(buttons, "Fullscreen", "maximize-2", 2, function() W:ToggleFullscreen() end)
		TopButton(buttons, "Close", "x", 3, closeFn, true)
	end

	table.insert(W._conns, Connect(UserInputService.InputBegan, function(input)
		if W.Destroyed or not W.ToggleKey then return end
		if UserInputService:GetFocusedTextBox() then return end
		if input.KeyCode == W.ToggleKey then W:Toggle() end
	end))

	W.ConfigManager = WindUI._NewConfigManager(W)

	-- 小屏自适应缩放 + 居中
	task.defer(function()
		local vp = gui.AbsoluteSize
		if (vp.X <= 0 or vp.Y <= 0) and workspace.CurrentCamera then vp = workspace.CurrentCamera.ViewportSize end
		local w, h = size.X.Offset, size.Y.Offset
		if cfg.AutoScale ~= false and vp.X > 0 and w > 0 then
			local s = math.min(1, (vp.X - 24) / w, (vp.Y - 24) / h)
			userScale.Scale = math.max(s, 0.45)
		end
		local s = userScale.Scale
		root.Position = UDim2.new(0.5, -w * s / 2, 0.5, -h * s / 2)
		W.Position = root.Position
	end)

	if WindUI.Acrylic then W:_SetAcrylic(true) end
	ApplyTheme(true)
	W:Open()
	task.delay(1.5, function()
		if not W.Destroyed and W.ConfigManager then pcall(function() W.ConfigManager:LoadAutoLoad() end) end
	end)
	return W
end

function WindUI:ToggleAcrylic(on)
	self.Acrylic = on and true or false
	for _, W in ipairs(self.Windows) do W:_SetAcrylic(self.Acrylic) end
	ApplyTheme(false)
end

function WindUI:Destroy()
	for i = #self.Windows, 1, -1 do self.Windows[i]:Destroy() end
	for _, c in ipairs(self.Connections) do pcall(function() c:Disconnect() end) end
	if Overlay then Overlay:Destroy() end
	self.Unloaded = true
end

--------------------------------------------------------------------------
-- Tab 方法 + SubTab (meyyUI 效果)
--------------------------------------------------------------------------
function TabMethods:Select()
	self.Window:SelectTab(self)
end

function TabMethods:SetTitle(t)
	self.Title = t or ""
	local label = self.Frame:FindFirstChild("Title")
	if label then label.Text = self.Title end
	self.Window:_SetPageTitle(self)
end

function TabMethods:SetIcon(icon)
	local img = self.Frame:FindFirstChild("Icon")
	if img then img.Image = GetIcon(icon) or "" end
end

function TabMethods:Lock()
	self.Locked = true
	self._Restyle()
end

function TabMethods:Unlock()
	self.Locked = false
	self._Restyle()
end

function TabMethods:ScrollToTop()
	Spring(self.UIElements.Page, { CanvasPosition = Vector2.new(0, 0) }, 3, 1)
end

-- 子标签栏固定在内容区顶部 (不随页面滚动); 添加第一个子标签时页面整体下移让位;
-- 所有子页面共用一个容器叠放在页面最上方, 只显示当前选中的那个
function TabMethods:SubTab(a, b)
	local cfg = NormalizeArgs(a, b)
	local tab = self
	local W = tab.Window
	local page = tab.UIElements.Page
	if #tab.SubTabs == 0 then
		tab._PageY = SUBBAR
		tab._SubBar.Visible = true
		Set(page, { Position = UDim2.new(0, 0, 0, SUBBAR), Size = UDim2.new(1, 0, 1, -SUBBAR) })
		tab._SubHolder = Create("Frame", {
			Name = "SubPagesHolder",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = -50,
			Parent = page,
		})
		List(tab._SubHolder, 0)
	end

	local index = #tab.SubTabs + 1
	local subPage = Create("Frame", {
		Name = "SubPage",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Visible = index == 1,
		LayoutOrder = index,
		Parent = tab._SubHolder,
	})
	List(subPage, 8)

	local sub = NewHost(W, tab, subPage, {
		__type = "SubTab",
		Title = cfg.Title or "Tab",
		Index = index,
		Selected = index == 1,
		Page = subPage,
	})

	local btn = Create("TextButton", {
		Name = "SubTab",
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.new(0, cfg.Width or 96, 1, -4),
		LayoutOrder = index,
		ZIndex = 30,
		Theme = {
			BackgroundColor3 = function(t) return sub.Selected and t.Accent or t.Element end,
			BackgroundTransparency = function(t)
				if sub.Selected then return 0.15 end
				return t.ElementT
			end,
		},
		Parent = tab._SubBar,
	})
	Corner(8, btn)
	Rim(btn, "ElementStrokeT", 1.2)
	local tOff = 0
	if cfg.Icon and GetIcon(cfg.Icon) then
		IconImage(cfg.Icon, 14, {
			AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), ZIndex = 31,
			Theme = { ImageColor3 = function(t) return sub.Selected and t.OnAccent or t.Text end },
			Parent = btn,
		})
		tOff = 18
	end
	local label = Text({
		Name = "Title",
		Text = sub.Title,
		Font = "Bold",
		TextSize = 12,
		Position = UDim2.new(0, 4 + tOff, 0, 0),
		Size = UDim2.new(1, -(8 + tOff), 1, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 31,
		Theme = { TextColor3 = function(t) return sub.Selected and t.OnAccent or t.Text end },
		Parent = btn,
	})
	-- 注意: 不能用 sub.Button 作字段名, 会盖住 HostMethods.Button (控件方法)
	sub.UIElements = { Button = btn, Page = subPage }

	local function restyle(s)
		Restyle(s.UIElements.Button, 3.5)
		for _, d in ipairs(s.UIElements.Button:GetDescendants()) do
			if Bindings[d] then Restyle(d, 3.5) end
		end
	end

	function sub:Select()
		for _, s in ipairs(tab.SubTabs) do
			s.Selected = s == sub
			s.Page.Visible = s == sub
			restyle(s)
		end
		tab.SelectedSubTab = sub
	end

	function sub:SetTitle(t)
		sub.Title = t or ""
		label.Text = sub.Title
	end

	function sub:Destroy()
		btn:Destroy()
		subPage:Destroy()
		local i = Find(tab.SubTabs, sub)
		if i then table.remove(tab.SubTabs, i) end
	end

	btn.MouseButton1Click:Connect(function() sub:Select() end)
	PressScale(btn)
	table.insert(tab.SubTabs, sub)
	if index == 1 then tab.SelectedSubTab = sub end
	return sub
end
TabMethods.AddSubTab = TabMethods.SubTab
TabMethods.CreateSubTab = TabMethods.SubTab

function TabMethods:SelectSubTab(i)
	local s = type(i) == "number" and self.SubTabs[i] or i
	if s then s:Select() end
end

--------------------------------------------------------------------------
-- 配置系统 (Window.ConfigManager)
--------------------------------------------------------------------------
local function Sanitize(name)
	return (tostring(name):gsub("[^%w%-_ ]", "_"))
end

local function Serialize(E)
	local t = E.__type
	if t == "Toggle" or t == "Input" or t == "Keybind" then
		return { __type = t, value = E.Value }
	elseif t == "Slider" then
		return { __type = t, value = E.Value.Default }
	elseif t == "Dropdown" then
		local v = E.Value
		if E.Multi then
			local out = {}
			for _, x in ipairs(v) do table.insert(out, ItemKey(x)) end
			v = out
		elseif v ~= nil then
			v = ItemKey(v)
		end
		return { __type = t, value = v }
	elseif t == "Colorpicker" then
		return { __type = t, value = ColorToHex(E.Value), transparency = E.Transparency }
	end
	return nil
end

local function Apply(E, entry)
	local t = E.__type
	if t == "Colorpicker" then
		local ok, c = pcall(Color3.fromHex, entry.value)
		if ok and c then E:Update(c, entry.transparency) end
	elseif t == "Dropdown" then
		E:Select(entry.value)
	elseif E.Set then
		E:Set(entry.value)
	end
end

function WindUI._NewConfigManager(W)
	local CM = { Window = W, Configs = {} }
	CM.Path = "WindUI/" .. Sanitize(W.Folder) .. "/config"
	pcall(function()
		if not isfolder("WindUI") then makefolder("WindUI") end
		if not isfolder("WindUI/" .. Sanitize(W.Folder)) then makefolder("WindUI/" .. Sanitize(W.Folder)) end
		if not isfolder(CM.Path) then makefolder(CM.Path) end
	end)

	function CM:CreateConfig(name)
		name = Sanitize(name or "default")
		if CM.Configs[name] then return CM.Configs[name] end
		local C = { Name = name, Elements = {} }
		local file = CM.Path .. "/" .. name .. ".json"
		function C:Register(flag, element) C.Elements[flag] = element end
		function C:GetData()
			local data = {}
			for flag, E in pairs(W.Flags) do data[flag] = Serialize(E) end
			for flag, E in pairs(C.Elements) do data[flag] = Serialize(E) end
			return { __version = 1, __elements = data }
		end
		function C:Save()
			local ok = pcall(function() writefile(file, HttpService:JSONEncode(C:GetData())) end)
			return ok
		end
		function C:Load()
			local ok, data = pcall(function() return HttpService:JSONDecode(readfile(file)) end)
			if not ok or type(data) ~= "table" then return false end
			for flag, entry in pairs(data.__elements or {}) do
				local E = C.Elements[flag] or W.Flags[flag]
				if E and type(entry) == "table" then pcall(Apply, E, entry) end
			end
			return true
		end
		function C:Delete()
			CM.Configs[name] = nil
			return pcall(function() delfile(file) end)
		end
		function C:SetAsCurrent() W.CurrentConfig = C end
		function C:SetAutoLoad(v)
			pcall(function() writefile(CM.Path .. "/autoload.txt", v and name or "") end)
		end
		CM.Configs[name] = C
		return C
	end
	CM.Config = CM.CreateConfig

	function CM:GetConfig(name) return CM.Configs[Sanitize(name)] end

	function CM:AllConfigs()
		local out = {}
		pcall(function()
			for _, f in ipairs(listfiles(CM.Path)) do
				local n = tostring(f):match("([^/\\]+)%.json$")
				if n then table.insert(out, n) end
			end
		end)
		table.sort(out)
		return out
	end

	function CM:DeleteConfig(name)
		return CM:CreateConfig(name):Delete()
	end

	function CM:GetAutoLoad()
		local ok, n = pcall(function() return readfile(CM.Path .. "/autoload.txt") end)
		if ok and type(n) == "string" and n ~= "" then return n end
		return nil
	end

	function CM:LoadAutoLoad()
		local n = CM:GetAutoLoad()
		if n then return CM:CreateConfig(n):Load() end
		return false
	end

	return CM
end

function WindowMethods:SetCurrentConfig(C)
	self.CurrentConfig = C
end

--------------------------------------------------------------------------
-- 内置设置页: 主题 / 透明度 / 模糊 / 缩放 / 快捷键 / 配置管理
--------------------------------------------------------------------------
function WindowMethods:CreateSettingsTab(opts)
	opts = opts or {}
	local W = self
	local CM = W.ConfigManager
	local tab = W:Tab({ Title = opts.Title or "设置", Icon = opts.Icon or "settings" })

	local look = tab:Section({ Title = "外观", Icon = "palette" })
	look:Dropdown({
		Title = "主题配色",
		Desc = "共 " .. #WindUI.ThemeOrder .. " 套, 切换时平滑过渡",
		Values = WindUI.ThemeOrder,
		Value = WindUI.CurrentThemeName,
		SearchBarEnabled = true,
		Callback = function(v) WindUI:SetTheme(v) end,
	})
	look:Slider({
		Title = "玻璃透明度",
		Value = { Min = 0, Max = 100, Default = math.floor(WindUI.Transparency * 100 + 0.5) },
		Step = 1,
		Callback = function(v) WindUI:SetTransparency(v / 100) end,
	})
	look:Toggle({
		Title = "背景模糊 (Acrylic)",
		Desc = "真实模糊游戏画面, 需要画质 ≥ 8",
		Value = WindUI.Acrylic,
		Callback = function(v) WindUI:ToggleAcrylic(v) end,
	})
	look:Slider({
		Title = "界面缩放 (%)",
		Value = { Min = 50, Max = 150, Default = math.floor(W:GetUIScale() * 100 + 0.5) },
		Step = 5,
		Callback = function(v) W:SetUIScale(v / 100) end,
	})
	look:Keybind({
		Title = "显示 / 隐藏快捷键",
		Value = W.ToggleKey and W.ToggleKey.Name or "None",
		ChangedCallback = function(k)
			W:SetToggleKey(k)
		end,
	})

	if CM then
		local cfgSec = tab:Section({ Title = "配置", Icon = "folder" })
		local nameInput = cfgSec:Input({ Title = "配置名", Placeholder = "default", InputIcon = "file" })
		local list = cfgSec:Dropdown({ Title = "已保存的配置", Values = CM:AllConfigs(), AllowNone = true })
		local function selected()
			local n = nameInput.Value
			if n == nil or n == "" then n = list.Value end
			return n
		end
		local function refresh() list:Refresh(CM:AllConfigs()) end
		local row1 = cfgSec:Group()
		row1:Button({ Title = "保存", Icon = "save", Callback = function()
			local n = selected()
			if not n or n == "" then
				WindUI:Notify({ Title = "配置", Content = "请先输入或选择配置名", Type = "Warning" })
				return
			end
			local ok = CM:CreateConfig(n):Save()
			refresh()
			WindUI:Notify({ Title = "配置", Content = ok and ("已保存: " .. n) or "保存失败 (执行器不支持文件读写?)", Type = ok and "Success" or "Error" })
		end })
		row1:Button({ Title = "加载", Icon = "download", Callback = function()
			local n = selected()
			if not n or n == "" then return end
			local ok = CM:CreateConfig(n):Load()
			WindUI:Notify({ Title = "配置", Content = ok and ("已加载: " .. n) or "加载失败", Type = ok and "Success" or "Error" })
		end })
		local row2 = cfgSec:Group()
		row2:Button({ Title = "删除", Icon = "trash-2", Callback = function()
			local n = selected()
			if not n or n == "" then return end
			CM:DeleteConfig(n)
			refresh()
			WindUI:Notify({ Title = "配置", Content = "已删除: " .. n })
		end })
		row2:Button({ Title = "刷新列表", Icon = "refresh-cw", Callback = refresh })
		cfgSec:Toggle({
			Title = "自动加载",
			Desc = "下次执行脚本时自动加载所选配置",
			Value = CM:GetAutoLoad() ~= nil,
			Callback = function(v)
				local n = selected()
				if n and n ~= "" then CM:CreateConfig(n):SetAutoLoad(v) end
			end,
		})
	end
	return tab
end

--------------------------------------------------------------------------
-- 主循环
--------------------------------------------------------------------------
Connect(RunService.RenderStepped, function(dt)
	StepSprings(dt)
	local wins = WindUI.Windows
	for i = #wins, 1, -1 do
		local W = wins[i]
		if W and W._Step then W:_Step(dt) end
	end
end)

return WindUI
