-- 拖拽: began(input) / moved(input) / ended(input)
local function OnDrag(handle, began, moved, ended)
	handle.InputBegan:Connect(function(input)
		if not IsClick(input) then return end
		if began and began(input) == false then return end
		local moveConn, endConn
		moveConn = UserInputService.InputChanged:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseMovement or i == input
				or (input.UserInputType == Enum.UserInputType.Touch and i.UserInputType == Enum.UserInputType.Touch) then
				if moved then moved(i) end
			end
		end)
		endConn = UserInputService.InputEnded:Connect(function(i)
			if i == input or i.UserInputType == Enum.UserInputType.MouseButton1
				or (input.UserInputType == Enum.UserInputType.Touch and i.UserInputType == Enum.UserInputType.Touch) then
				moveConn:Disconnect()
				endConn:Disconnect()
				if ended then ended(i) end
			end
		end)
	end)
end

