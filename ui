local function GetIcon(icon)
	if icon == nil or icon == "" then return nil end
	if type(icon) == "number" then return "rbxassetid://" .. icon end
	if type(icon) ~= "string" then return nil end
	if icon:find("^rbxasset") or icon:find("^rbxthumb") or icon:find("^http") then return icon end
	if tonumber(icon) then return "rbxassetid://" .. icon end
	local name = icon:gsub("^lucide[%-:]", ""):gsub("^geist:", ""):lower()
	local id = IconMap[name]
	if id then return "rbxassetid://" .. id end
	return nil
end
WindUI.GetIcon = GetIcon

function WindUI:AddIcons(map)
	for k, v in pairs(map or {}) do
		IconMap[tostring(k):lower()] = tonumber(tostring(v):match("%d+"))
	end
end

