	function W:SetToTheCenter()
		local s = userScale.Scale
		local sz = root.AbsoluteSize
		local target = UDim2.new(0.5, -sz.X / 2, 0.5, -sz.Y / 2)
		if sz.X <= 0 then target = UDim2.new(0.5, -root.Size.X.Offset * s / 2, 0.5, -root.Size.Y.Offset * s / 2) end
		Spring(root, { Position = target }, 3.5, 0.85)
