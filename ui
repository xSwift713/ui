function HostMethods:Group()
	local frame = Create("Frame", {
		Name = "Group",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = self:_Order(),
		Parent = self.Container,
	})
	List(frame, 8, true)
	local G = NewHost(self.Window, self.Tab, frame, { __type = "Group", Items = {}, ElementFrame = frame })
	function G:_Added(E)
		local f = E.ElementFrame
		if not f then return end
		table.insert(G.Items, f)
		local n = #G.Items
		for _, item in ipairs(G.Items) do
			item.Size = UDim2.new(1 / n, -8 * (n - 1) / n, item.Size.Y.Scale, item.Size.Y.Offset)
		end
	end
	function G:Destroy() frame:Destroy() end
	self:_Added(G)
	return G
end

