local Acrylic = { Users = 0, Saved = {} }

function Acrylic.EnableDOF()
	if Acrylic.DOF then return end
	for _, obj in ipairs(Lighting:GetChildren()) do
		if obj:IsA("DepthOfFieldEffect") then
			Acrylic.Saved[obj] = obj.Enabled
			obj.Enabled = false
		end
	end
	local dof = Instance.new("DepthOfFieldEffect")
	dof.Name = "LiquidGlassDOF"
	dof.FarIntensity = 0
	dof.InFocusRadius = 0.1
	dof.NearIntensity = 1
	dof.Parent = Lighting
	Acrylic.DOF = dof
end

function Acrylic.DisableDOF()
	if Acrylic.DOF then
		Acrylic.DOF:Destroy()
		Acrylic.DOF = nil
	end
	for obj, en in pairs(Acrylic.Saved) do
		pcall(function() obj.Enabled = en end)
	end
	Acrylic.Saved = {}
end

function Acrylic.New()
	local part = Instance.new("Part")
	part.Name = "LiquidGlassBlur"
	part.Color = BLACK
	part.Material = Enum.Material.Glass
	part.Size = Vector3.new(1, 1, 0)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Locked = true
	part.CastShadow = false
	part.Transparency = 0.98
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Brick
	mesh.Offset = Vector3.new(0, 0, -1e-6)
	mesh.Parent = part
	return part, mesh
end

function Acrylic.Update(part, mesh, frame)
	local cam = workspace.CurrentCamera
	if not cam then return end
	local pos, size = frame.AbsolutePosition, frame.AbsoluteSize
	local vy = cam.ViewportSize.Y
	local inset = 8 + (math.clamp(vy, 0, 2560) / 2560) * 48
	local tl = pos + Vector2.new(inset / 2, inset / 2)
	local br = pos + size - Vector2.new(inset / 2, inset / 2)
	local function at(x, y)
		local ray = cam:ScreenPointToRay(x, y)
		return ray.Origin + ray.Direction * 0.001
	end
	local p1, p2, p3 = at(tl.X, tl.Y), at(br.X, tl.Y), at(br.X, br.Y)
	local cf = cam.CFrame
	part.CFrame = CFrame.fromMatrix((p1 + p3) / 2, cf.XVector, cf.YVector, cf.ZVector)
	mesh.Scale = Vector3.new((p2 - p1).Magnitude, (p2 - p3).Magnitude, 0)
end

